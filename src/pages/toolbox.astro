---
import { getCollection } from 'astro:content';
import {
  BaseHead,
  Footer,
  MainNavigation,
  CommandPalette,
  LLMDiscoveryNote,
} from '@components/layout/index';
import { ToolCard } from '@components/ui/index';

// One grid, newest-updated first
const toolboxPages = (await getCollection('toolboxPages')).sort(
  (a, b) => b.data.lastEdited.getTime() - a.data.lastEdited.getTime(),
);

const categories = [
  ...new Set(toolboxPages.map(t => t.data.category).filter((c): c is string => Boolean(c))),
].sort();

const slugify = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-');

const DESCRIPTION =
  'An ever-growing collection of best practices, tools and advice on work, management, culture-building, leadership and communication – geared towards remote and distributed teams.';

// A single ItemList of generic CreativeWorks, matching the pattern on /making.
const toolboxJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'The Toolbox',
  description: DESCRIPTION,
  itemListElement: toolboxPages.map((tool, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'CreativeWork',
      name: tool.data.title,
      url: tool.data.url,
    },
  })),
};

// CSS-only filtering: checking a category radio hides every card that isn't in
// that category. The rules are generated at build time from the known categories.
const filterCss = categories
  .map(
    c =>
      `main:has(#filter-${slugify(c)}:checked) .tool-card:not([data-category="${c}"]) { display: none; }`,
  )
  .join('\n');
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Toolbox" description={DESCRIPTION} pageType="page" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(toolboxJsonLd)} />
    <style is:inline set:html={filterCss}></style>
  </head>
  <body>
    <MainNavigation />
    <CommandPalette />
    <main
      id="main"
      tabindex="-1"
      class="ui-style"
      data-pagefind-body
      data-pagefind-meta="type:page"
    >
      <LLMDiscoveryNote />
      <h1 class="title" data-pagefind-meta="title">The Toolbox</h1>
      <div class="header">
        <p class="intro">
          An ever-growing collection of <strong>best practices</strong>, <strong>tools</strong> and <strong
            >advice</strong
          > on work, management, culture-building, leadership and communication – geared towards remote
          and distributed teams.
        </p>
        <p>
          Over the years I've developed or collected a bunch of practices, tools and techniques to
          help teams work better together. This toolbox is my attempt to collate this stuff into one
          place in the hope that it'll help others. Most of the practices in here were developed
          while working with remote, distributed teams, but nearly all of them will also be useful
          to hybrid or office-based teams too.
        </p>
      </div>

      <nav class="filters" aria-label="Filter tools by category">
        <input type="radio" name="category-filter" id="filter-all" checked />
        <label for="filter-all">All</label>
        {
          categories.map(category => (
            <>
              <input type="radio" name="category-filter" id={`filter-${slugify(category)}`} />
              <label for={`filter-${slugify(category)}`}>{category}</label>
            </>
          ))
        }
      </nav>

      <section class="toolbox-grid">
        {toolboxPages.map(toolboxPage => <ToolCard tool={toolboxPage} />)}
      </section>
    </main>
    <Footer />

    <script>
      // Progressive enhancement: wrap filter changes in a view transition so the
      // browser animates cards morphing/fading between filter states. The actual
      // filtering (and the instant fallback) is pure CSS via the radios.
      document.querySelector('.filters')?.addEventListener('click', event => {
        const label = event.target instanceof Element ? event.target.closest('label') : null;
        if (!label) return;
        const input = document.getElementById(label.htmlFor);
        if (!(input instanceof HTMLInputElement) || input.checked) return;
        if (!document.startViewTransition || matchMedia('(prefers-reduced-motion: reduce)').matches)
          return;
        event.preventDefault();
        document.startViewTransition(() => {
          input.checked = true;
        });
      });
    </script>

    <style>
      .title {
        font-family: var(--font-display);
        font-size: clamp(3rem, 10vw, 20rem);
        font-weight: var(--font-weight-extrabold);
        text-transform: uppercase;
        font-feature-settings: 'case' on;
        text-align: right;
        line-height: var(--leading-none);
        translate: 0 -0.2em;
        pointer-events: none;
      }

      .header {
        max-inline-size: 130ch;
        margin-inline: var(--space-l);
        margin-block-end: var(--space-xl);
        font-size: var(--font-size-sm);
        font-weight: var(--font-weight-light);
        line-height: var(--leading-normal);
      }

      .intro {
        font-size: var(--font-size-md);
        margin-block-end: var(--space-m);
      }

      .filters {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: var(--space-2xs);
        margin-inline: auto;
        margin-block-end: var(--space-m);
        padding: var(--space-m);
        max-inline-size: 1600px;

        /* Visually hidden but still focusable, so the labels act as tabs */
        & input {
          position: absolute;
          inline-size: 1px;
          block-size: 1px;
          opacity: 0;
        }

        & label {
          padding: 0.4em 0.9em 0.3em;
          font-size: var(--font-size-xs);
          font-weight: var(--font-weight-medium);
          line-height: 1;
          text-transform: uppercase;
          font-feature-settings: 'case' on;
          letter-spacing: var(--tracking-wide);
          color: var(--color-text-secondary);
          border: var(--border-width-hairline) solid var(--color-border);
          border-radius: var(--radius-xs);
          cursor: pointer;
          transition:
            color var(--duration-fast) var(--ease-in-out),
            background-color var(--duration-fast) var(--ease-in-out),
            border-color var(--duration-fast) var(--ease-in-out);

          &:hover {
            color: var(--color-text);
            border-color: var(--color-text-secondary);
          }
        }

        & input:checked + label {
          color: var(--color-background);
          background-color: var(--color-text);
          border-color: var(--color-text);
        }

        & input:focus-visible + label {
          outline: var(--border-width-base) solid var(--color-accent);
          outline-offset: 2px;
        }
      }

      .toolbox-grid {
        display: grid;
        /* min(380px, 100%) so the grid can't overflow viewports narrower than a column */
        grid-template-columns: repeat(auto-fill, minmax(min(380px, 100%), 1fr));
        gap: var(--space-m);
        margin-inline: var(--space-l);
        margin-block-end: var(--space-xl);
      }
    </style>
  </body>
</html>
