---
import {
  BaseHead,
  CommandPalette,
  Footer,
  HomeLinkList,
  LLMDiscoveryNote,
  MainNavigation,
} from '@components/layout/index'
import { getConfig } from '@config/config'

const config = getConfig()
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={config.site.name} description={config.descriptions.site} />
  </head>
  <body itemtype="https://schema.org/ProfilePage" itemscope>
    <MainNavigation />
    <CommandPalette />
    <main
      id="main"
      tabindex="-1"
      class="vcard h-card ui-style"
      itemtype="http://schema.org/Person"
      itemprop="mainEntity"
      itemscope
    >
      <LLMDiscoveryNote />
      <a rel="me" href={Astro.site?.href} class="u-url u-uid hidden-microformat">Danny Smith</a>
      <h1 class="fn p-name" itemprop="name">
        <span itemprop="givenName">Danny</span>
        <span itemprop="familyName">Smith</span>
      </h1>
      <div class="links">
        <HomeLinkList />
      </div>
      <img
        src="/icon.jpg"
        alt="Danny Smith Profile Image"
        class="avatar u-photo"
        loading="lazy"
        width={200}
        height={200}
        itemprop="image"
      />

      <style>
        main {
          display: grid;
          grid-template-columns: 1rem auto 1fr;
          min-block-size: 100svh;
        }

        h1 {
          grid-column: 1 / -1;
          font-family: var(--font-display);
          font-size: clamp(3rem, 14.3vw, 22rem);
          font-weight: var(--font-weight-extrabold);
          text-transform: uppercase;
          font-feature-settings: 'case' on;
          margin-top: -0.1em;
          pointer-events: none;
          line-height: var(--leading-none);
        }

        .links {
          grid-column: 2 / 3;
          min-width: 0;
        }

        .avatar {
          display: none;
        }

        @media (max-width: 500px) {
          main {
            grid-template-columns: 1fr;
            padding-inline: var(--space-s);
          }

          .links {
            grid-column: 1;
          }
        }
      </style>
    </main>
    <Footer />
  </body>
</html>
