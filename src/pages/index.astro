---
import { getCollection } from 'astro:content'
import {
  BaseHead,
  CommandPalette,
  Footer,
  HomeLinkList,
  HomepageLatestArticles,
  LLMDiscoveryNote,
  MainNavigation,
} from '@components/layout/index'
import { NoteCard, ProjectCard, ToolCard } from '@components/ui/index'
import { filterContentForListing } from '@utils/content'
import { getConfig } from '@config/config'

const config = getConfig()

// --- Homepage content sections (stacked for now; layout comes later) ---
const projects = await getCollection('projects')
const featuredProjects = projects.filter(p => p.data.featured)
const projectsToShow = (featuredProjects.length > 0 ? featuredProjects : projects).slice(0, 4)

const notes = filterContentForListing(await getCollection('notes'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4)

const toolboxPages = await getCollection('toolboxPages')
const randomTools = [...toolboxPages].sort(() => Math.random() - 0.5).slice(0, 4)
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={config.site.name} description={config.descriptions.site} />
  </head>
  <body itemtype="https://schema.org/ProfilePage" itemscope>
    <MainNavigation />
    <CommandPalette />
    <main
      id="main"
      tabindex="-1"
      class="vcard h-card ui-style"
      itemtype="http://schema.org/Person"
      itemprop="mainEntity"
      itemscope
    >
      <LLMDiscoveryNote />
      <a rel="me" href={Astro.site?.href} class="u-url u-uid hidden-microformat">Danny Smith</a>
      <h1 class="fn p-name" itemprop="name">
        <span itemprop="givenName">Danny</span>
        <span itemprop="familyName">Smith</span>
      </h1>
      <div class="links">
        <HomeLinkList />
      </div>
      <img
        src="/icon.jpg"
        alt="Danny Smith Profile Image"
        class="avatar u-photo"
        loading="lazy"
        width={200}
        height={200}
        itemprop="image"
      />

      <!-- Content sections, stacked for now — layout work comes later -->
      <div class="home-content">
        <section id="latest-articles">
          <div class="cq">
            <HomepageLatestArticles />
          </div>
        </section>

        <section id="latest-notes">
          <h2>Recent notes</h2>
          <div class="stack">
            {notes.map(note => <NoteCard item={note} compact />)}
          </div>
        </section>

        <section id="from-the-toolbox">
          <h2>From the toolbox</h2>
          <div class="stack">
            {randomTools.map(tool => <ToolCard item={tool} />)}
          </div>
        </section>

        <section id="featured-projects">
          <h2>Featured projects</h2>
          <div class="stack">
            {projectsToShow.map(project => <ProjectCard item={project} />)}
          </div>
        </section>
      </div>

      <style>
        main {
          display: grid;
          grid-template-columns: 1rem auto 1fr;
          min-block-size: 100svh;
        }

        h1 {
          grid-column: 1 / -1;
          font-family: var(--font-display);
          font-size: clamp(3rem, 14.3vw, 22rem);
          font-weight: var(--font-weight-extrabold);
          text-transform: uppercase;
          font-feature-settings: 'case' on;
          margin-top: -0.1em;
          pointer-events: none;
          line-height: var(--leading-none);
        }

        .links {
          grid-column: 2 / 3;
          min-width: 0;
        }

        .avatar {
          display: none;
        }

        /* Content sections span the full hero grid and stack for now. */
        .home-content {
          grid-column: 1 / -1;
        }

        #latest-articles {
          border-block-end: var(--border-width-accent) solid var(--color-accent);
          padding-block-end: var(--space-xs);

          > div {
            max-width: 70%;
          }
        }

        #featured-projects,
        #from-the-toolbox,
        #latest-notes {
          margin: 0 auto;
          padding: var(--space-xl);

          h2 {
            font-family: var(--font-display);
            font-size: var(--font-size-lg);
            font-weight: var(--font-weight-extrabold);
            text-transform: uppercase;
            font-feature-settings: 'case' on;
            border-block-end: none;
          }

          .stack {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
            gap: var(--space-m);
          }
        }

        @media (max-width: 500px) {
          main {
            grid-template-columns: 1fr;
            padding-inline: var(--space-s);
          }

          .links {
            grid-column: 1;
          }
        }
      </style>
    </main>
    <Footer />
  </body>
</html>
