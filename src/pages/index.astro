---
import { getCollection } from 'astro:content'
import {
  BaseHead,
  CommandPalette,
  Footer,
  HomeLinkList,
  HomepageLatestArticles,
  LLMDiscoveryNote,
  MainNavigation,
} from '@components/layout/index'
import { NoteCard, ProjectCard, ToolCard } from '@components/ui/index'
import { filterContentForListing } from '@utils/content'
import { getConfig } from '@config/config'

const config = getConfig()

// --- Homepage content sections ---
const projects = await getCollection('projects')
const featuredProjects = projects.filter(p => p.data.featured)
const projectsToShow = (featuredProjects.length > 0 ? featuredProjects : projects).slice(0, 4)

const notes = filterContentForListing(await getCollection('notes'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4)

const toolboxPages = await getCollection('toolboxPages')
const randomTools = [...toolboxPages].sort(() => Math.random() - 0.5).slice(0, 2)
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={config.site.name} description={config.descriptions.site} />
  </head>
  <body itemtype="https://schema.org/ProfilePage" itemscope>
    <MainNavigation />
    <CommandPalette />
    <main
      id="main"
      tabindex="-1"
      class="home vcard h-card ui-style"
      itemtype="http://schema.org/Person"
      itemprop="mainEntity"
      itemscope
    >
      <LLMDiscoveryNote />
      <a rel="me" href={Astro.site?.href} class="u-url u-uid hidden-microformat">Danny Smith</a>

      <h1 class="home-title fn p-name" itemprop="name">
        <span itemprop="givenName">Danny</span>
        <span itemprop="familyName">Smith</span>
      </h1>

      <div class="home-grid">
        <div class="home-links">
          <HomeLinkList />
        </div>

        <section class="home-writing" aria-label="Recent writing">
          <HomepageLatestArticles />
        </section>

        <section class="home-notes" aria-label="Recent notes">
          <h2 class="section-heading">Recent <a href="/notes">notes</a></h2>
          <div class="card-grid">
            {notes.map(note => <NoteCard item={note} compact />)}
          </div>
        </section>

        <section class="home-toolbox" aria-label="A few random tools from the toolbox">
          <h2 class="section-heading">Random tools from <a href="/toolbox">the toolbox</a></h2>
          <div class="card-grid">
            {randomTools.map(tool => <ToolCard item={tool} />)}
          </div>
        </section>

        <section class="home-projects" aria-label="Current projects">
          <h2 class="section-heading">Current <a href="/making">projects</a></h2>
          <div class="card-grid">
            {projectsToShow.map(project => <ProjectCard item={project} />)}
          </div>
        </section>
      </div>

      <img
        src="/icon.jpg"
        alt="Danny Smith Profile Image"
        class="avatar u-photo"
        loading="lazy"
        width={200}
        height={200}
        itemprop="image"
      />
    </main>
    <Footer />
  </body>
</html>

<style>
  .home {
    padding-block-end: var(--space-2xl);
  }

  .home-title {
    font-family: var(--font-display);
    text-align: right;
    font-size: clamp(3rem, 13.8vw, 22rem);
    font-weight: var(--font-weight-extrabold);
    text-transform: uppercase;
    font-feature-settings: 'case' on;
    /* transform, not a negative margin — the latter collapses into <body> and
       drags the absolutely-positioned nav up as the vw font scales. */
    margin-top: 0;
    transform: translateY(-0.1em);
    pointer-events: none;
    line-height: var(--leading-none);
  }

  .home-grid {
    display: grid;
    padding-inline: var(--space-s);
    margin-block-start: var(--space-2xl);
    gap: var(--space-xl);
    grid-template-columns: 1fr;
    grid-template-areas:
      'links'
      'writing'
      'notes'
      'toolbox'
      'projects';
  }

  .home-links {
    grid-area: links;
    min-width: 0;
  }

  .home-writing {
    grid-area: writing;
    container-type: inline-size;
    border-block-start: var(--border-width-accent) solid var(--color-accent);
  }

  .home-notes {
    grid-area: notes;
    border-block-start: var(--border-width-accent) solid var(--color-text);
  }

  .home-toolbox {
    grid-area: toolbox;
  }

  .home-projects {
    grid-area: projects;
  }

  .home-toolbox,
  .home-projects {
    display: flex;
    flex-direction: column;
  }

  .home-toolbox .card-grid,
  .home-projects .card-grid {
    flex: 1;
    grid-auto-rows: 1fr;
  }

  .section-heading {
    font-family: var(--font-display);
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-extrabold);
    text-transform: uppercase;
    font-feature-settings: 'case' on;
    border-block-end: none;

    a {
      color: var(--color-accent);
    }
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-s);
    margin-block-start: var(--space-s);
  }

  .avatar {
    display: none;
  }

  @media (min-width: 40rem) {
    .home-grid {
      padding-inline: var(--space-m);
      gap: var(--space-2xl) var(--space-l);
      grid-template-columns: 1fr 1fr;
      grid-template-areas:
        'links   links'
        'writing writing'
        'notes   notes'
        'toolbox toolbox'
        'projects projects';
    }

    .home-toolbox .card-grid,
    .home-projects .card-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 56rem) {
    .home-grid {
      grid-template-areas:
        'links   writing'
        'notes   notes'
        'toolbox toolbox'
        'projects projects';
    }
  }

  @media (min-width: 72rem) {
    .home-grid {
      grid-template-columns: repeat(4, 1fr);
      grid-template-areas:
        'links   notes   writing writing'
        'toolbox toolbox projects projects';
    }

    .home-notes .card-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
