---
import { getCollection } from 'astro:content'
import {
  BaseHead,
  CommandPalette,
  Footer,
  HomeLinkList,
  HomepageLatestArticles,
  LLMDiscoveryNote,
  MainNavigation,
} from '@components/layout/index'
import { NoteCard, ProjectCard, ToolCard } from '@components/ui/index'
import { filterContentForListing } from '@utils/content'
import { getConfig } from '@config/config'

const config = getConfig()

// --- Homepage content sections ---
const projects = await getCollection('projects')
const featuredProjects = projects.filter(p => p.data.featured)
const projectsToShow = (featuredProjects.length > 0 ? featuredProjects : projects).slice(0, 4)

const notes = filterContentForListing(await getCollection('notes'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4)

const toolboxPages = await getCollection('toolboxPages')
const randomTools = [...toolboxPages].sort(() => Math.random() - 0.5).slice(0, 2)
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={config.site.name} description={config.descriptions.site} />
  </head>
  <body itemtype="https://schema.org/ProfilePage" itemscope>
    <MainNavigation />
    <CommandPalette />
    <main
      id="main"
      tabindex="-1"
      class="home vcard h-card ui-style"
      itemtype="http://schema.org/Person"
      itemprop="mainEntity"
      itemscope
    >
      <LLMDiscoveryNote />
      <a rel="me" href={Astro.site?.href} class="u-url u-uid hidden-microformat">Danny Smith</a>

      <h1 class="home-title fn p-name" itemprop="name">
        <span itemprop="givenName">Danny</span>
        <span itemprop="familyName">Smith</span>
      </h1>

      <div class="home-grid">
        <div class="home-links">
          <HomeLinkList />
        </div>

        <section class="home-writing" aria-label="Recent writing">
          <HomepageLatestArticles />
        </section>

        <section class="home-notes" aria-label="Recent notes">
          <h2 class="section-heading">Recent <a href="/notes">notes</a></h2>
          <div class="card-grid">
            {notes.map(note => <NoteCard item={note} compact />)}
          </div>
        </section>

        <section class="home-toolbox" aria-label="From the toolbox">
          <h2 class="section-heading">Random tools from <a href="/toolbox">the toolbox</a></h2>
          <div class="card-grid">
            {randomTools.map(tool => <ToolCard item={tool} />)}
          </div>
        </section>

        <section class="home-projects" aria-label="Featured projects">
          <h2 class="section-heading">Current <a href="/projects">projects</a></h2>
          <div class="card-grid">
            {projectsToShow.map(project => <ProjectCard item={project} />)}
          </div>
        </section>
      </div>

      <img
        src="/icon.jpg"
        alt="Danny Smith Profile Image"
        class="avatar u-photo"
        loading="lazy"
        width={200}
        height={200}
        itemprop="image"
      />
    </main>
    <Footer />
  </body>
</html>

<style>
  /* Breathing room before the footer (padding so it can't margin-collapse). */
  .home {
    padding-block-end: var(--space-2xl);
  }

  /* The title is always the same, so it sits outside the content grid and
     bleeds to the page edge exactly as before. */
  .home-title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 14.3vw, 22rem);
    font-weight: var(--font-weight-extrabold);
    text-transform: uppercase;
    font-feature-settings: 'case' on;
    margin-top: -0.1em;
    pointer-events: none;
    line-height: var(--leading-none);
  }

  /* One grid drives the content sections; placement lives in
     `grid-template-areas`, so each layout is just a different template. It
     densifies mobile-first through the breakpoints below: a stacked column,
     then the card sections pair up, then links and writing pair, and finally
     the wide layout tucks the notes between them. */
  .home-grid {
    display: grid;
    padding-inline: var(--space-s);
    margin-block-start: var(--space-2xl);
    gap: var(--space-xl);
    grid-template-columns: 1fr;
    grid-template-areas:
      'links'
      'writing'
      'notes'
      'toolbox'
      'projects';
  }

  .home-links {
    grid-area: links;
    min-width: 0;
  }

  .home-writing {
    grid-area: writing;
    container-type: inline-size;
    /* Playground: a jaunty tilt — tune or drop. */
    /* rotate: 20deg; */
    border-block-start: var(--border-width-accent) solid var(--color-accent);
  }

  .home-notes {
    grid-area: notes;
    border-block-start: var(--border-width-accent) solid var(--color-text);
  }

  .home-toolbox {
    grid-area: toolbox;
  }

  .home-projects {
    grid-area: projects;
  }

  /* When toolbox and projects sit side by side (wide layout) they already
     stretch to a shared row height. Make each a flex column and let its card
     grid fill that height (with 1fr rows), so all the cards match — footers
     aligned — without needing subgrid. */
  .home-toolbox,
  .home-projects {
    display: flex;
    flex-direction: column;
  }

  .home-toolbox .card-grid,
  .home-projects .card-grid {
    flex: 1;
    grid-auto-rows: 1fr;
  }

  .section-heading {
    font-family: var(--font-display);
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-extrabold);
    text-transform: uppercase;
    font-feature-settings: 'case' on;
    border-block-end: none;

    a {
      color: var(--color-accent);
    }
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-s);
    margin-block-start: var(--space-s);
  }

  .avatar {
    display: none;
  }

  /* First grid step: pair the toolbox and projects card sections; links,
     writing and notes stay full-width. */
  @media (min-width: 40rem) {
    .home-grid {
      padding-inline: var(--space-m);
      gap: var(--space-2xl) var(--space-l);
      grid-template-columns: 1fr 1fr;
      grid-template-areas:
        'links   links'
        'writing writing'
        'notes   notes'
        'toolbox toolbox'
        'projects projects';
    }

    /* Toolbox and projects each get a two-column card grid. Cards stretch to
       the full height of their row on their own (grid stretch + each card's
       flex-grow footer), so no subgrid is needed. */
    .home-toolbox .card-grid,
    .home-projects .card-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Pair links with writing too; notes take their own full-width row. */
  @media (min-width: 56rem) {
    .home-grid {
      grid-template-areas:
        'links   writing'
        'notes   notes'
        'toolbox toolbox'
        'projects projects';
    }
  }

  /* Wide: links, a vertical stack of notes, and recent writing across the top;
     toolbox and projects paired below. */
  @media (min-width: 72rem) {
    .home-grid {
      grid-template-columns: repeat(4, 1fr);
      grid-template-areas:
        'links   notes   writing writing'
        'toolbox toolbox projects projects';
    }

    /* Notes become a single-column vertical stack in their middle slot. */
    .home-notes .card-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
