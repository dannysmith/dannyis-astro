---
/**
 * Scratchpad — a noindex page for eyeballing components in isolation.
 */
import { getCollection } from 'astro:content';
import { BaseHead, MainNavigation } from '@components/layout/index';
import { ToolCard } from '@components/ui/index';
import ResizableContainer from '@components/mdx/ResizableContainer.astro';

const toolboxPages = await getCollection('toolboxPages');
const emojiTool = toolboxPages.find(t => t.id === 'writing-good-evergreen-documents');
const imageIconTool = toolboxPages.find(
  t => t.id === 'creating-managing-and-archiving-slack-channels',
);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Scratchpad"
      description="Component testing"
      robotsDirective="noindex, nofollow"
    />
  </head>
  <body>
    <MainNavigation />
    <main id="main" tabindex="-1">
      <h1>Hello world</h1>

      <h2>ToolCard (emoji icon)</h2>
      <ResizableContainer initialWidth="420px" minWidth="220px">
        {emojiTool && <ToolCard tool={emojiTool} />}
      </ResizableContainer>

      <h2>ToolCard (image icon)</h2>
      <ResizableContainer initialWidth="420px" minWidth="220px">
        {imageIconTool && <ToolCard tool={imageIconTool} />}
      </ResizableContainer>

      <h2>ToolCard (compact — all {toolboxPages.length} tools)</h2>
      <ResizableContainer initialWidth="600px" minWidth="180px">
        <div class="compact-stack">
          {toolboxPages.map(tool => <ToolCard tool={tool} compact />)}
        </div>
      </ResizableContainer>
    </main>
  </body>
</html>

<style>
  main {
    padding-block: var(--space-xl);
    margin-inline: auto;
    padding-inline: var(--space-m);

    & h2 {
      margin-block: var(--space-m) var(--space-xs);
      font-size: var(--font-size-sm);
      color: var(--color-text-secondary);
    }
  }

  .compact-stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }
</style>
