---
/**
 * Scratchpad — a noindex page for eyeballing components in isolation.
 * Empty by default: drop whatever you want to experiment with into <main>.
 */
import {
  BaseHead,
  CommandPalette,
  Footer,
  MainNavigation,
  LLMDiscoveryNote,
} from '@components/layout/index'
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Scratchpad"
      description="Component playground"
      robotsDirective="noindex, nofollow"
    />
  </head>
  <body>
    <MainNavigation />
    <CommandPalette />
    <main id="main" tabindex="-1">
      <LLMDiscoveryNote />
      <h1>Scratchpad</h1>
    </main>
    <Footer />
  </body>
</html>
