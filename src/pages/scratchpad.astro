---
/**
 * Scratchpad — a noindex page for eyeballing components in isolation.
 *
 * Currently: a rough homepage layout playground — featured projects,
 * latest articles, latest notes, and a couple of random toolbox pages.
 */
import { getCollection } from 'astro:content'
import { BaseHead, MainNavigation } from '@components/layout/index'
import { ArticleCard, NoteCard, ProjectCard, ToolCard } from '@components/ui/index'
import { LLMDiscoveryNote, CommandPalette, Footer } from '@components/layout/index'
import { filterContentForListing } from '@utils/content'

// --- Featured projects ---
const projects = await getCollection('projects')
const featuredProjects = projects.filter(p => p.data.featured)
const projectsToShow = (featuredProjects.length > 0 ? featuredProjects : projects).slice(0, 4)

// --- Latest articles ---
const articles = filterContentForListing(await getCollection('articles'))
  .filter(a => !a.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
const latestArticles = articles.slice(0, 3)

// --- Latest notes ---
const notes = filterContentForListing(await getCollection('notes')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
)
const latestNotes = notes.slice(0, 4)

// --- Random toolbox pages ---
const toolboxPages = await getCollection('toolboxPages')
const randomTools = [...toolboxPages].sort(() => Math.random() - 0.5).slice(0, 4)
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Scratchpad"
      description="Homepage layout playground"
      robotsDirective="noindex, nofollow"
    />
  </head>
  <body>
    <MainNavigation />
    <main id="main" tabindex="-1">
      <LLMDiscoveryNote />
      <CommandPalette />
      <section id="latest-articles">
        <h2>Writing</h2>
        <div class="stack">
          {latestArticles.map(article => <ArticleCard item={article} />)}
        </div>
      </section>

      <section id="latest-notes">
        <h2>Recent notes</h2>
        <div class="stack">
          {latestNotes.map(note => <NoteCard item={note} compact />)}
        </div>
      </section>

      <section id="from-the-toolbox">
        <h2>From the toolbox</h2>
        <div class="stack">
          {randomTools.map(tool => <ToolCard item={tool} />)}
        </div>
      </section>

      <section id="featured-projects">
        <h2>Current projects</h2>
        <div class="stack">
          {projectsToShow.map(project => <ProjectCard item={project} />)}
        </div>
      </section>

    </main>
    <Footer />
  </body>
</html>
<style>
  main {
    margin: 0 auto;
    padding: var(--space-xl);
  }

  section {
    margin-top: var(--space-xl);

    .stack {
      margin-top: var(--space-m);
    }
  }

  #featured-projects .stack {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    gap: var(--space-m);
  }

  #from-the-toolbox .stack {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    gap: var(--space-m);
  }
</style>
