---
/**
 * Scratchpad — a noindex page for eyeballing components in isolation.
 *
 * Currently: the BookmarkCard test bench. Every URL here is a real page that
 * exhibits the labelled behaviour (verified by probing them, not guessed), so
 * this page is the manual check for link-metadata work. Expect it to change or
 * empty out once that work is done — nothing else depends on it.
 */
import {
  BaseHead,
  CommandPalette,
  Footer,
  MainNavigation,
  LLMDiscoveryNote,
} from '@components/layout/index'
import { BookmarkCard, ResizableContainer } from '@components/mdx/index'

interface Case {
  /** What this URL exercises. */
  label: string
  url: string
  /** What good looks like once the metadata work is done. */
  expect: string
}

const healthy: Case[] = [
  {
    label: 'Baseline — full metadata, 1200×630 image',
    url: 'https://maggieappleton.com/gastown',
    expect: 'Title, description, image, domain. The card everything else is measured against.',
  },
  {
    label: 'No image (the most common shape — ~25% of real links)',
    url: 'https://blog.jim-nielsen.com/2026/make-it-work-make-it-good/',
    expect: 'Title + description + domain, laid out so the missing image looks deliberate.',
  },
  {
    label: 'No og: tags at all, <title> only',
    url: 'https://ntietz.com/blog/that-boolean-should-probably-be-something-else/',
    expect: 'Falls back to <title>; no description.',
  },
  {
    label: 'Tracking params in the URL',
    url: 'https://karlbode.com/the-ai-hype-reckoning-is-upon-us/?utm_source=the-index&utm_medium=newsletter',
    expect: 'Displayed URL drops utm_*; the link itself is untouched.',
  },
]

const textCleanup: Case[] = [
  {
    label: 'Entity-escaped apostrophe (&#x27;)',
    url: 'https://bricolage.io/essential-until-it-wasnt/',
    expect: '"Essential Until It Wasn\'t", with a real apostrophe.',
  },
  {
    label: 'Entity-escaped apostrophe + site-name suffix',
    url: 'https://seths.blog/2025/08/aha/',
    expect:
      '<title> is "Aha! | Seth&#039;s Blog"; og:title gives "Aha!", and the suffix would go anyway.',
  },
  {
    label: 'Entity-escaped quotes AND a raw apostrophe — silent truncation',
    url: 'https://perevillega.com/posts/2026-02-24-llms-are-monkey-paws/',
    expect:
      'Whole title, decoded quotes and all. The old regex stopped dead at the raw apostrophe.',
  },
  {
    label: 'og:title much terser than <title>',
    url: 'https://lucumr.pocoo.org/2024/9/3/progress/',
    expect:
      'og:title is just "Progress"; <title> adds the author. og:title wins unless it is only the site name.',
  },
  {
    label: 'Site name duplicated as a title prefix',
    url: 'https://github.com/dannysmith/tauri-template',
    expect: 'Leading site names are kept: too often the prefix is the useful half.',
  },
]

const images: Case[] = [
  {
    label: 'Relative og:image path',
    url: 'https://oilwell.app',
    expect: 'og:image is /preview/Oilwell-OG-5.jpg — resolve it against the final URL.',
  },
  {
    label: 'Relative og:image path (second case)',
    url: 'https://replaceyourboss.ai',
    expect:
      'og:image is /OGImage.jpg. Both were broken images before the URL was resolved against the page.',
  },
  {
    label: 'og:image URL with entity-escaped query params',
    url: 'https://www.cubic.dev/blog/the-real-problem-with-ai-coding',
    expect:
      'og:image is `…png?width=2720&amp;height=1568`. Requested with the literal &amp; it 400s, so the attribute has to be decoded before use.',
  },
  {
    label: 'Tiny square image (150×150)',
    url: 'https://laike9m.com/blog/avoid-mini-frameworks,171/?ref=sidebar',
    expect: "It's a logo, not a banner — contain it rather than cropping to 16:9.",
  },
  {
    label: 'Square image (400×400)',
    url: 'https://interconnected.org/home/2026/03/28/architecture',
    expect: 'Same logo treatment.',
  },
  {
    label: 'Dynamically generated OG image (rate-limits at build)',
    url: 'https://github.com/aisk/timeout',
    expect: 'Self-hosting the image removes the rate-limit exposure entirely.',
  },
]

const failures: Case[] = [
  {
    label: '404 — but the error page still serves og: tags',
    url: 'https://github.com/dannysmith/this-repo-does-not-exist',
    expect: 'Never "Build software better, together". Marked as dead; metadata ignored.',
  },
  {
    label: '403 Cloudflare block',
    url: 'https://medium.com/@dannysmith/breaking-down-problems-its-hard-when-you-re-learning-to-code-f10269f4ccd5',
    expect: 'Title derived from the URL. Blocked is not dead — no dead marker.',
  },
  {
    label: '200 bot-challenge page (403s the Facebook UA)',
    url: 'https://lore.kernel.org/linux-media/CAHk-=wi4zC+Ze8e+p3tMv8TtG_80KzsZ1syL9anBtmEh5Z40vg@mail.gmail.com/',
    expect: 'Never "Making sure you\'re not a bot" — a 200 challenge page is still blocked.',
  },
  {
    label: '429 rate-limited, and an archive.ph wrapper',
    url: 'https://archive.ph/20260811223012/https://www.economist.com/culture/2026/07/30/how-to-spot-ai-writing#selection-1279.0-1353.201',
    expect: 'Unwrap the archived URL and show the Economist article, hinted as archived.',
  },
  {
    label: 'Redirect chain (Substack → custom domain)',
    url: 'https://techtrenches.substack.com/p/the-great-software-quality-collapse',
    expect: 'Domain line shows where it actually lands.',
  },
  {
    label: 'Non-HTML (PDF, after a redirect)',
    url: 'https://danny.is/cv.pdf',
    expect: 'Derived title + a PDF hint. Never downloads or parses the body.',
  },
  {
    label: 'Ancient HTML — no metadata whatsoever, plain HTTP',
    url: 'http://info.cern.ch/hypertext/WWW/TheProject.html',
    expect: 'Title from <title>; nothing else to show.',
  },
  {
    label: 'Domain that does not resolve',
    url: 'https://this-domain-does-not-resolve.invalid/some/page',
    expect: 'Title derived from the path. Warns, never fails the build.',
  },
  {
    label: 'Malformed URL',
    url: 'not-a-url',
    expect: 'Renders something sane and does not throw.',
  },
]

/**
 * A grab-bag of real links, here purely to look at. No expectations attached —
 * this is the "does it cope with whatever I throw at it" section.
 */
const assorted = [
  'https://amyhupe.co.uk/articles/design-system-strategies/',
  'https://lethain.com/decisions-not-dates/',
  'https://www.localfirst.fm/',
  'https://lucumr.pocoo.org/2026/7/13/the-tower-keeps-rising/',
  'https://tropopause.pckt.blog/on-atproto-and-atmospheric-groups-jqdept6',
  'https://bsky.network/docs/jetstream/',
  'https://bsky.app/profile/fasterthanli.me/post/3mth45dvjz22d',
  'https://code.claude.com/docs/en/permission-modes#eliminate-prompts-with-auto-mode',
  'https://danny.is/writing/loomclone-part-2/',
  'https://www.youtube.com/watch?v=Tqz7da31ryI',
]

const groups: Array<{ heading: string; note: string; cases: Case[] }> = [
  {
    heading: 'Healthy',
    note: 'These should already look right. They are here to catch regressions.',
    cases: healthy,
  },
  {
    heading: 'Text cleanup',
    note: 'Entity decoding, attribute parsing, and title tidying.',
    cases: textCleanup,
  },
  { heading: 'Images', note: 'Resolution, shape, and availability.', cases: images },
  {
    heading: 'Failure modes',
    note: 'Each of these should degrade to something that reads as deliberate.',
    cases: failures,
  },
]
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Scratchpad"
      description="Component playground"
      robotsDirective="noindex, nofollow"
    />
  </head>
  <body>
    <MainNavigation />
    <CommandPalette />
    <main id="main" tabindex="-1">
      <LLMDiscoveryNote />
      <h1>Scratchpad</h1>

      <h2>BookmarkCard test bench</h2>
      <p>
        Real URLs, each exercising one behaviour. Until link metadata is cached, every render of
        this page hits {healthy.length + textCleanup.length + images.length + failures.length} external
        sites.
      </p>

      {
        groups.map(group => (
          <section class="bench-group">
            <h3>{group.heading}</h3>
            <p>{group.note}</p>
            {group.cases.map(item => (
              <div class="bench-case">
                <p class="bench-label">{item.label}</p>
                <BookmarkCard url={item.url} />
                <p class="bench-expect">{item.expect}</p>
              </div>
            ))}
          </section>
        ))
      }

      <section class="bench-group">
        <h3>Assorted real links</h3>
        <p>
          Whatever happened to be open in a browser. Note that two of these route to a different
          embed in real content — <code>Embed</code> sends bsky.app posts to a Bluesky embed and YouTube
          URLs to a player; they only render as cards because this page calls
          <code>BookmarkCard</code> directly.
        </p>
        {
          assorted.map(url => (
            <div class="bench-case">
              <p class="bench-label">{url}</p>
              <BookmarkCard url={url} />
            </div>
          ))
        }
      </section>

      <section class="bench-group">
        <h3>Narrow containers</h3>
        <p>
          The card switches to a horizontal layout at a 400px container. Drag these to check the
          stacked layout, where the image currently has no aspect ratio and shifts the layout as it
          loads.
        </p>
        <ResizableContainer initialWidth="360px">
          <BookmarkCard url="https://maggieappleton.com/gastown" />
        </ResizableContainer>
        <ResizableContainer initialWidth="360px">
          <BookmarkCard url="https://interconnected.org/home/2026/03/28/architecture" />
        </ResizableContainer>
        <ResizableContainer initialWidth="360px">
          <BookmarkCard url="https://blog.jim-nielsen.com/2026/make-it-work-make-it-good/" />
        </ResizableContainer>
      </section>
    </main>
    <Footer />
  </body>
</html>

<style>
  main {
    max-width: 100ch;
    margin-inline: auto;
    padding-block: var(--space-2xl);
    padding-inline: var(--space-m);
  }

  .bench-group {
    margin-block: var(--space-l);
  }

  .bench-case {
    margin-block: var(--space-m);
  }

  .bench-label {
    font-family: var(--font-code);
    font-size: var(--font-size-xs);
    margin-block-end: var(--space-2xs);
  }

  .bench-expect {
    font-size: var(--font-size-sm);
    font-style: italic;
    margin-block-start: var(--space-2xs);
    opacity: 0.75;
  }
</style>
