---
/**
 * Scratchpad — a noindex page for eyeballing components in isolation.
 *
 * Currently: all card components (NoteCard, ProjectCard, ToolCard,
 * ContentCard) in their full and compact variants, for the card review.
 */
import { getCollection } from 'astro:content'
import { BaseHead, MainNavigation } from '@components/layout/index'
import { ArticleCard, ContentCard, NoteCard, ProjectCard, ToolCard } from '@components/ui/index'
import ResizableContainer from '@components/mdx/ResizableContainer.astro'
import { filterContentForListing } from '@utils/content'

// --- Sample content ---
const toolboxPages = await getCollection('toolboxPages')
const emojiTool = toolboxPages.find(t => t.id === 'writing-good-evergreen-documents')
const imageIconTool = toolboxPages.find(
  t => t.id === 'creating-managing-and-archiving-slack-channels',
)

const projects = await getCollection('projects')
const sampleProject = projects.find(p => p.id === 'astro-editor')

const articles = filterContentForListing(await getCollection('articles')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
)
const articleWithCover = articles.find(a => a.data.cover)
const articleNoCover = articles.find(a => !a.data.cover)
const articlePlatform = articles.find(a => a.data.platform)
const articleSeries = articles.find(a => a.data.series)
const articleUpdated = articles.find(
  a => a.data.updatedDate && a.data.updatedDate.toDateString() !== a.data.pubDate.toDateString(),
)

const notes = filterContentForListing(await getCollection('notes')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
)
const sampleNote = notes.find(n => n.id === '2026-07-15-moving-uses-pages-site') ?? notes[0]
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Scratchpad"
      description="Component testing"
      robotsDirective="noindex, nofollow"
    />
  </head>
  <body>
    <MainNavigation />
    <main id="main" tabindex="-1">
      <h1>Card components</h1>

      <h2>ArticleCard (with cover)</h2>
      <ResizableContainer initialWidth="420px" minWidth="220px">
        {articleWithCover && <ArticleCard item={articleWithCover} />}
      </ResizableContainer>

      <h2>ArticleCard (without cover)</h2>
      <ResizableContainer initialWidth="420px" minWidth="220px">
        {articleNoCover && <ArticleCard item={articleNoCover} />}
      </ResizableContainer>

      <h2>ArticleCard (external platform)</h2>
      <ResizableContainer initialWidth="420px" minWidth="220px">
        {articlePlatform && <ArticleCard item={articlePlatform} />}
      </ResizableContainer>

      <h2>ArticleCard (part of a series)</h2>
      <ResizableContainer initialWidth="420px" minWidth="220px">
        {articleSeries && <ArticleCard item={articleSeries} />}
      </ResizableContainer>

      <h2>ArticleCard (with updated date)</h2>
      <ResizableContainer initialWidth="420px" minWidth="220px">
        {
          articleUpdated ? (
            <ArticleCard item={articleUpdated} />
          ) : (
            <p>No article with a distinct updatedDate found.</p>
          )
        }
      </ResizableContainer>

      <h2>ArticleCard (grid of 4)</h2>
      <ResizableContainer initialWidth="900px" minWidth="260px">
        <div class="card-grid">
          {articles.slice(0, 4).map(article => <ArticleCard item={article} />)}
        </div>
      </ResizableContainer>

      <h2>ArticleCard (compact — recent 6)</h2>
      <ResizableContainer initialWidth="600px" minWidth="180px">
        <div class="compact-stack">
          {articles.slice(0, 6).map(article => <ArticleCard item={article} compact />)}
        </div>
      </ResizableContainer>

      <h2>NoteCard (full — primary display)</h2>
      <ResizableContainer initialWidth="700px" minWidth="220px">
        <NoteCard item={sampleNote} />
      </ResizableContainer>

      <h2>NoteCard (compact — recent 5)</h2>
      <ResizableContainer initialWidth="600px" minWidth="180px">
        <div class="compact-stack">
          {notes.slice(0, 5).map(note => <NoteCard item={note} compact />)}
        </div>
      </ResizableContainer>

      <h2>ProjectCard (full — primary display)</h2>
      <ResizableContainer initialWidth="900px" minWidth="220px">
        {sampleProject && <ProjectCard item={sampleProject} />}
      </ResizableContainer>

      <h2>ProjectCard (compact — all {projects.length} projects)</h2>
      <ResizableContainer initialWidth="600px" minWidth="180px">
        <div class="compact-stack">
          {projects.map(project => <ProjectCard item={project} compact />)}
        </div>
      </ResizableContainer>

      <h2>ToolCard (emoji icon)</h2>
      <ResizableContainer initialWidth="420px" minWidth="220px">
        {emojiTool && <ToolCard item={emojiTool} />}
      </ResizableContainer>

      <h2>ToolCard (image icon)</h2>
      <ResizableContainer initialWidth="420px" minWidth="220px">
        {imageIconTool && <ToolCard item={imageIconTool} />}
      </ResizableContainer>

      <h2>ToolCard (compact — all {toolboxPages.length} tools)</h2>
      <ResizableContainer initialWidth="600px" minWidth="180px">
        <div class="compact-stack">
          {toolboxPages.map(tool => <ToolCard item={tool} compact />)}
        </div>
      </ResizableContainer>

      <h2>ContentCard (article with cover)</h2>
      <ResizableContainer initialWidth="420px" minWidth="220px">
        {articleWithCover && <ContentCard content={articleWithCover} />}
      </ResizableContainer>

      <h2>ContentCard (article without cover)</h2>
      <ResizableContainer initialWidth="420px" minWidth="220px">
        {articleNoCover && <ContentCard content={articleNoCover} />}
      </ResizableContainer>

      <h2>ContentCard (note)</h2>
      <ResizableContainer initialWidth="420px" minWidth="220px">
        <ContentCard content={sampleNote} />
      </ResizableContainer>

      <h2>ContentCard (compact)</h2>
      <ResizableContainer initialWidth="600px" minWidth="180px">
        <div class="compact-stack">
          {articles.slice(0, 2).map(article => <ContentCard content={article} compact />)}
          <ContentCard content={sampleNote} compact />
        </div>
      </ResizableContainer>
    </main>
  </body>
</html>

<style>
  main {
    padding-block: var(--space-xl);
    margin-inline: auto;
    padding-inline: var(--space-m);

    & h2 {
      margin-block: var(--space-m) var(--space-xs);
      font-size: var(--font-size-sm);
      color: var(--color-text-secondary);
    }
  }

  .compact-stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(18rem, 100%), 1fr));
    gap: var(--space-s);
  }
</style>
