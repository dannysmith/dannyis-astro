---
import { getCollection } from 'astro:content';
import {
  BaseHead,
  Footer,
  Lightbox,
  LLMDiscoveryNote,
  MainNavigation,
} from '@components/layout/index';
import { ProjectCard } from '@components/ui/index';
import { getSortedProjects } from '@utils/content';
import { getConfig } from '@config/config';

const config = getConfig();
const projects = getSortedProjects(await getCollection('projects'));

// A single ItemList of generic CreativeWorks — enough for crawlers and LLMs to
// see the projects without per-project pages or type-specific modelling.
const projectsJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Things Danny Smith has made',
  itemListElement: projects.map((project, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'CreativeWork',
      name: project.data.title,
      description: project.data.byline,
      url: project.data.website ?? project.data.github ?? `${config.site.url}/making#${project.id}`,
      ...(project.data.icon && { image: `${config.site.url}${project.data.icon.src}` }),
      author: { '@type': 'Person', name: config.author.fullName, url: config.site.url },
    },
  })),
};
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Making"
      description="Projects and things Danny Smith has made and is making."
      pageType="page"
    />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(projectsJsonLd)} />
  </head>
  <body>
    <MainNavigation />
    <main
      id="main"
      tabindex="-1"
      class="ui-style"
      data-pagefind-body
      data-pagefind-meta="type:page"
    >
      <LLMDiscoveryNote />
      <h1 class="title" data-pagefind-meta="title">Making</h1>
      <p class="intro">Some of the stuff I've been making recently</p>
      <div class="projects cq">
        {projects.map(project => <ProjectCard project={project} />)}
      </div>
    </main>
    <Footer />
    <Lightbox />
    <style>
      .title {
        font-family: var(--font-display);
        font-size: clamp(3rem, 14vw, 20rem);
        font-weight: var(--font-weight-extrabold);
        text-transform: uppercase;
        font-feature-settings: 'case' on;
        text-align: right;
        line-height: var(--leading-none);
        transform: translateY(-0.2em);
        pointer-events: none;
      }

      .intro {
        font-size: var(--font-size-md);
        font-weight: var(--font-weight-light);
        font-family: var(--font-display);
        text-transform: uppercase;
        font-feature-settings: 'case' on;
        text-align: right;
        margin-inline: var(--space-l);
        margin-block-start: 0;
      }

      .projects {
        display: grid;
        gap: var(--space-l);
        padding: var(--space-l);
        max-width: 100rem;
        margin-inline: auto;
      }
    </style>
  </body>
</html>
