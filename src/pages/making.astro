---
import { getCollection } from 'astro:content';
import { BaseHead, Footer, LLMDiscoveryNote, MainNavigation } from '@components/layout/index';
import { ProjectCard } from '@components/ui/index';
import { getSortedProjects } from '@utils/content';

const projects = getSortedProjects(await getCollection('projects'));
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Making"
      description="Projects and things Danny Smith has made and is making."
      pageType="page"
    />
  </head>
  <body>
    <MainNavigation />
    <main id="main" tabindex="-1" class="ui-style">
      <LLMDiscoveryNote />
      <h1 class="title">Making</h1>
      <div class="projects">
        {projects.map(project => <ProjectCard project={project} />)}
      </div>
    </main>
    <Footer />
    <style>
      .title {
        font-family: var(--font-display);
        font-size: clamp(3rem, 14vw, 20rem);
        font-weight: var(--font-weight-extrabold);
        text-transform: uppercase;
        font-feature-settings: 'case' on;
        text-align: right;
        line-height: var(--leading-none);
        transform: translateY(-0.2em);
        pointer-events: none;
      }
    </style>
  </body>
</html>
