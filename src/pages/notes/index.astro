---
import { getCollection } from 'astro:content'
import {
  BaseHead,
  CommandPalette,
  Footer,
  LLMDiscoveryNote,
  MainNavigation,
} from '@components/layout/index'
import { NoteCard } from '@components/ui/index'
import { filterContentForListing } from '@utils/content'

const notes = filterContentForListing(await getCollection('notes')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
)

// Latest few shown in full; the rest as compact cards below.
const numberOfRecentNotes = 2
const recentNotes = notes.slice(0, numberOfRecentNotes)
const olderNotes = notes.slice(numberOfRecentNotes)
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Notes"
      description="Short-form thoughts and observations on remote work, technology, and business operations"
      pageType="page"
    />
  </head>
  <body>
    <MainNavigation />
    <CommandPalette />
    <main id="main" tabindex="-1">
      <LLMDiscoveryNote />
      <h1 class="title ui-style">Notes</h1>

      <!-- Latest notes, shown in full -->
      {
        recentNotes.length > 0 && (
          <section class="recent-notes" aria-label="Recent notes">
            {recentNotes.map(note => (
              <div class="note-container cq" style={`--vt-name: note-${note.id}`}>
                <NoteCard item={note} />
              </div>
            ))}
          </section>
        )
      }

      <!-- Older notes as compact cards -->
      {
        olderNotes.length > 0 && (
          <section class="archive-section" aria-label="Older notes">
            <div class="archive-content">
              <h2 class="archive-title ui-style">Older Notes</h2>
              <div class="notes-grid">
                {olderNotes.map(note => (
                  <NoteCard item={note} compact />
                ))}
              </div>
            </div>
          </section>
        )
      }
    </main>
    <Footer />
    <style>
      body {
        display: grid;
        grid-template-rows: auto min-content;
      }

      .title {
        font-family: var(--font-display);
        font-size: clamp(3rem, 14vw, 20rem);
        font-weight: var(--font-weight-extrabold);
        text-transform: uppercase;
        font-feature-settings: 'case' on;
        text-align: right;
        line-height: var(--leading-none);
        transform: translateY(-0.1em);
        pointer-events: none;
        margin: 0;
        border: 0;
      }

      .note-container {
        max-width: var(--measure-standard);
        width: 100%;
      }

      .archive-content {
        max-width: 56rem;
        width: 100%;
      }

      .notes-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
        gap: var(--space-m);
      }

      .recent-notes,
      .archive-section {
        padding: var(--space-s);
        display: grid;
        place-items: center;
      }

      .recent-notes {
        padding-block: var(--space-2xl);
        gap: var(--space-xl);
      }

      .archive-section {
        margin-top: var(--space-xl);
        padding-bottom: var(--space-2xl);
      }

      .archive-title {
        font-family: var(--font-display);
        text-transform: uppercase;
        font-feature-settings: 'case' on;
        font-size: var(--font-size-2xl);
        font-weight: var(--font-weight-extrabold);
        text-align: right;
        margin-bottom: var(--space-m);
        padding-bottom: var(--space-2xs);
        border-bottom: var(--border-width-base) solid var(--color-border);
      }

      @media (min-width: 800px) {
        .recent-notes,
        .archive-section {
          padding: var(--space-l);
        }

        .recent-notes {
          padding-top: var(--space-2xl);
        }
      }
    </style>
  </body>
</html>
