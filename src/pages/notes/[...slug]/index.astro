---
import { type CollectionEntry, getCollection } from 'astro:content'
import Note from '@layouts/Note.astro'
import { contentCacheKey, filterContentForPage } from '@utils/content'

export async function getStaticPaths() {
  const notes = filterContentForPage(await getCollection('notes'))
  return notes.map(note => ({
    params: { slug: note.id },
    props: note,
    // A note page renders only its own entry — nothing here reads another
    // entry — so the note's digest fully describes its data.
    cacheKey: contentCacheKey(note),
  }))
}
type Props = CollectionEntry<'notes'>
---

<Note note={Astro.props} />
