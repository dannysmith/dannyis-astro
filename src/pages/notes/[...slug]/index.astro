---
import { type CollectionEntry, getCollection } from 'astro:content'
import Note from '@layouts/Note.astro'
import { contentCacheKey, filterContentForPage, rendersOtherEntries } from '@utils/content'

export async function getStaticPaths() {
  const notes = filterContentForPage(await getCollection('notes'))
  return notes.map(note => ({
    params: { slug: note.id },
    props: note,
    // Nothing in the Note layout reads another entry, so only the body can.
    cacheKey: rendersOtherEntries(note) ? undefined : contentCacheKey(note),
  }))
}
type Props = CollectionEntry<'notes'>
---

<Note note={Astro.props} />
