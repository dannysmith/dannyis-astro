---
import { type CollectionEntry, getCollection, render } from 'astro:content'
import Article from '@layouts/Article.astro'
import { MDX_COMPONENT_REMAPPING } from '@config/mdx-components'
import { contentCacheKey, filterContentForPage } from '@utils/content'
import { generateSummary } from '@utils/content-summary'

export async function getStaticPaths() {
  const posts = filterContentForPage(await getCollection('articles'))
  return posts.map(post => ({
    params: { slug: post.id },
    props: post,
    // Articles in a series deliberately opt out of the incremental cache.
    // Article.astro renders SeriesCallout, which reads every sibling article
    // and the series entry itself. Astro's cache can't see those reads — it
    // tracks the entry a page *renders*, not entries it looks up — so this
    // post's own digest doesn't change when a sibling is retitled or added,
    // or when series.json is edited. Omitting the key re-renders these on
    // every build, which is the correct answer for ~20 of 76 articles.
    cacheKey: post.data.series ? undefined : contentCacheKey(post),
  }))
}
type Props = CollectionEntry<'articles'>

const post = Astro.props
const { Content, headings, remarkPluginFrontmatter } = await render(post)
const readingTime = remarkPluginFrontmatter.minutesRead
const hasFootnotes = remarkPluginFrontmatter.hasFootnotes ?? false
const description = post.data.description?.trim() || generateSummary(post)
const postData = { ...post.data, description, readingTime, headings, hasFootnotes }
---

<Article {...postData}>
  <Content components={MDX_COMPONENT_REMAPPING} />
</Article>
