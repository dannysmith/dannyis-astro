---
import { type CollectionEntry, getCollection, render } from 'astro:content'
import Article from '@layouts/Article.astro'
import { MDX_COMPONENT_REMAPPING } from '@config/mdx-components'
import { contentCacheKey, filterContentForPage, rendersOtherEntries } from '@utils/content'
import { generateSummary } from '@utils/content-summary'

export async function getStaticPaths() {
  const posts = filterContentForPage(await getCollection('articles'))
  return posts.map(post => ({
    params: { slug: post.id },
    props: post,
    // Two ways this page can read entries the cache can't see: SeriesCallout
    // (from `series` frontmatter) lists sibling articles, and the body may
    // embed one. Either means the post's own digest doesn't describe
    // everything rendered, so it re-renders every build.
    cacheKey: post.data.series || rendersOtherEntries(post) ? undefined : contentCacheKey(post),
  }))
}
type Props = CollectionEntry<'articles'>

const post = Astro.props
const { Content, headings, remarkPluginFrontmatter } = await render(post)
const readingTime = remarkPluginFrontmatter.minutesRead
const hasFootnotes = remarkPluginFrontmatter.hasFootnotes ?? false
const description = post.data.description?.trim() || generateSummary(post)
const postData = { ...post.data, description, readingTime, headings, hasFootnotes }
---

<Article {...postData}>
  <Content components={MDX_COMPONENT_REMAPPING} />
</Article>
