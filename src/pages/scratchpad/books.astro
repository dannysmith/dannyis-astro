---
/**
 * The books I'm currently reading, from the BookHive records on my PDS.
 *
 * A worked example of an AT Protocol source rather than a finished page: the
 * `books` collection is loaded by `atprotoLoader`, and each cover is brought
 * onto our domain by `atprotoImage` as it renders — so only the covers shown
 * here are ever downloaded. See docs/developer/atproto-data.md.
 *
 * Hidden like the rest of /scratchpad: noindex, and filtered out of the sitemap.
 */
import { getCollection } from 'astro:content'
import {
  BaseHead,
  CommandPalette,
  Footer,
  Lightbox,
  MainNavigation,
  LLMDiscoveryNote,
} from '@components/layout/index'
import { atprotoImage } from '@utils/atproto/index'

/**
 * Sized for the lightbox rather than the grid: it shows the mirrored file at
 * its natural size, and BookHive's covers are only ~500px tall to begin with,
 * so this keeps all of what little there is.
 */
const COVER_MAX_PX = 800

const reading = await getCollection('books', ({ data }) => data.status === 'reading')
const startedAt = (book: (typeof reading)[number]) => book.data.startedAt ?? book.data.createdAt

const books = await Promise.all(
  reading
    .sort((a, b) => startedAt(b).valueOf() - startedAt(a).valueOf())
    .map(async ({ id, data }) => ({
      id,
      title: data.title,
      authors: data.authors,
      cover: await atprotoImage(data.cover, { group: 'books', maxPx: COVER_MAX_PX }),
    })),
)
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Currently reading"
      description="Books I'm reading at the moment"
      robotsDirective="noindex, nofollow"
    />
  </head>
  <body>
    <MainNavigation />
    <CommandPalette />
    <main id="main" tabindex="-1">
      <LLMDiscoveryNote />
      <h1>Currently reading</h1>
      <ul class="list-reset books">
        {
          books.map(book => (
            <li class="book">
              {book.cover ? (
                <img
                  class="cover"
                  src={book.cover.src}
                  width={book.cover.width}
                  height={book.cover.height}
                  alt={`Cover of ${book.title}`}
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <div class="cover no-cover" />
              )}
              <div class="details">
                <strong class="title">{book.title}</strong>
                <span class="authors">{book.authors}</span>
              </div>
            </li>
          ))
        }
      </ul>
    </main>
    <Footer />
    <Lightbox />
    <style>
      main {
        max-inline-size: 75rem;
        margin-inline: auto;
        padding: var(--space-l);
      }

      /* The column minimum grows with the viewport: two columns on a phone,
         four on a tablet, six on a desktop. */
      .books {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(clamp(8rem, 11vw, 10rem), 100%), 1fr));
        gap: var(--space-l) var(--space-m);
        margin-block-start: var(--space-l);
      }

      /* Each book borrows two rows from the list's grid — cover, then details —
         so along a row the covers share a baseline however long the titles run. */
      .book {
        display: grid;
        grid-row: span 2;
        grid-template-rows: subgrid;
        row-gap: var(--space-xs);
      }

      .cover {
        align-self: end;
        inline-size: 100%;
        block-size: auto;
        border-radius: var(--radius-xs);
        filter: var(--shadow-medium);
      }

      .no-cover {
        aspect-ratio: 2 / 3;
        background: var(--color-background-secondary);
      }

      .title {
        display: -webkit-box;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 3;
        line-clamp: 3;
        overflow: hidden;
        font-size: var(--font-size-sm);
        line-height: var(--leading-tight);
      }

      .authors {
        display: block;
        margin-block-start: var(--space-3xs);
        color: var(--color-text-secondary);
        font-size: var(--font-size-xs);
      }
    </style>
  </body>
</html>
