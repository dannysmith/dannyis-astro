---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import {
  BaseHead,
  CommandPalette,
  Footer,
  LLMDiscoveryNote,
  MainNavigation,
  Lightbox,
} from '@components/layout/index'
import { BackToTopLink } from '@components/ui/index'

interface Props {
  frontmatter: {
    title: string
    subtitle?: string
    description?: string
    headingAlign?: 'left' | 'center' | 'right'
    heroImage?: string
    heroImageAlt?: string
  }
}

const { title, subtitle, description, headingAlign, heroImage, heroImageAlt } =
  Astro.props.frontmatter

const assetImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/**/*')
let heroSrc: ImageMetadata | undefined
if (heroImage) {
  const loadHero = assetImages[heroImage]
  if (loadHero) {
    heroSrc = (await loadHero()).default
  } else {
    console.warn(
      `[Page.astro] heroImage "${heroImage}" not found under /src/assets — no header banner rendered. Check the path.`,
    )
  }
}
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} pageType="page" />
  </head>
  <body>
    <MainNavigation />
    <CommandPalette />
    <main
      id="main"
      tabindex="-1"
      class="content flow"
      data-pagefind-body
      data-pagefind-meta="type:page"
    >
      {
        heroSrc && heroImageAlt && (
          <div class="hero-image">
            <Image
              src={heroSrc}
              alt={heroImageAlt}
              layout="constrained"
              width={1200}
              height={240}
              quality={85}
              format="webp"
            />
          </div>
        )
      }
      <LLMDiscoveryNote />
      <header data-align={headingAlign ?? 'left'} data-hassubtitle={subtitle ? true : undefined}>
        <h1 class="ui-style" data-pagefind-meta="title">
          {title}
        </h1>
        {subtitle && <h2 class="subtitle ui-style">{subtitle}</h2>}
      </header>
      <slot />
      <BackToTopLink />
    </main>
    <Footer class="footer" />
    <Lightbox />
    <style>
      body {
        display: flex;
        flex-direction: column;
        min-height: 100dvh;
      }

      .content {
        flex: 1;
        max-width: var(--measure-standard);
        width: 100%;
        margin-inline: auto;
        padding: var(--space-2xl) var(--space-s);
      }

      /* Full-bleed header banner (mirrors the Article cover): break out of the
         centred content column to span the viewport, and pull up flush under the
         floating nav. Relies on the hero being the first child so `flow` spacing
         doesn't fight the pull-up. */
      .hero-image {
        width: 100vw;
        margin-inline: calc(50% - 50vw);
        margin-block-start: calc(-1 * var(--space-2xl));
        aspect-ratio: 5 / 1;
        overflow: hidden;
      }

      .hero-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: light-dark(none, grayscale(70%));
      }

      h1,
      h2 {
        font-family: var(--font-display);
        text-transform: uppercase;
        font-feature-settings: 'case' on;
      }

      h1 {
        font-size: var(--font-size-3xl);
        font-weight: var(--font-weight-extrabold);
      }

      h2 {
        font-size: var(--font-size-md);
        font-weight: var(--font-weight-light);
      }

      header {
        &[data-align='center'] {
          text-align: center;
        }

        &[data-align='right'] {
          text-align: right;
        }

        &[data-hassubtitle] {
          h1 {
            border-block-end: none;
            padding-block-end: 0;
          }

          h2 {
            margin-block-start: 0;
          }
        }
      }
    </style>
  </body>
</html>
