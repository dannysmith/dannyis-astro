---
import type { CollectionEntry } from 'astro:content'
import {
  BaseHead,
  Footer,
  CommandPalette,
  LLMDiscoveryNote,
  MainNavigation,
} from '@components/layout/index'
import { NoteCard } from '@components/ui/index'
import { generateSummary } from '@utils/content-summary'
import { getDocumentUri } from '@utils/standard-site'

interface Props {
  note: CollectionEntry<'notes'>
}

const { note } = Astro.props
const { title, pubDate, draft, styleguide, tags } = note.data

const description = note.data.description?.trim() || generateSummary(note)

// Build OG image path for this note
const ogImage = `/notes/${note.id}/og-image.png`

// Root-relative URL of the raw markdown twin (served by [...slug].md.ts).
const markdownUrl = `/notes/${note.id}.md`

// standard.site document AT-URI for the <head> verification link tag (null for
// drafts, styleguides, or posts before the configured cutoff).
const standardSiteDocumentUri =
  getDocumentUri('notes', note.id, { draft, styleguide, pubDate }) ?? undefined
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      type="article"
      pageType="note"
      image={ogImage}
      pubDate={pubDate}
      tags={tags}
      standardSiteDocumentUri={standardSiteDocumentUri}
      markdownUrl={markdownUrl}
    />
  </head>

  <body>
    <MainNavigation />
    <CommandPalette />
    <main id="main" tabindex="-1" style={`--vt-name: note-${note.id}`}>
      <LLMDiscoveryNote />
      <NoteCard item={note} standalone />
    </main>

    <Footer />

    <style>
      body {
        display: grid;
        grid-template-rows: auto min-content;
        grid-template-columns: 100%;
      }

      main {
        padding: var(--space-s);
        padding-block: var(--space-2xl);
        display: grid;
        place-items: center;

        .note {
          max-width: var(--measure-standard);
        }
      }
    </style>
  </body>
</html>
