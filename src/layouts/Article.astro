---
import type { CollectionEntry } from 'astro:content'
import type { MarkdownHeading } from 'astro'
import { Image } from 'astro:assets'
import {
  BaseHead,
  Footer,
  InlineFootnotes,
  Lightbox,
  LLMDiscoveryNote,
  LongFormProseTypography,
  CommandPalette,
  MainNavigation,
  SeriesCallout,
  TableOfContents,
} from '@components/layout/index'
import { BackToTopLink, FormattedDate, MarkdownContentActions, Spinner } from '@components/ui/index'
import { getDocumentUri } from '@utils/standard-site'

type Props = CollectionEntry<'articles'>['data'] & {
  readingTime: string
  headings: MarkdownHeading[]
  hasFootnotes?: boolean
}
const {
  title,
  description,
  pubDate,
  updatedDate,
  cover,
  coverAlt,
  draft,
  styleguide,
  redirectURL,
  platform,
  readingTime,
  headings,
  tags,
  toc,
  hasFootnotes,
  series,
} = Astro.props

// Build OG image path for this article
const ogImage = `/writing/${Astro.params.slug}/og-image.png`

// Root-relative URL of the raw markdown twin (served by [...slug].md.ts).
const markdownUrl = `${Astro.url.pathname.replace(/\/$/, '')}.md`

// ISO date (YYYY-MM-DD) for Pagefind's `date` meta + recency sort. Date-only
// avoids colons, which the comma-separated `data-pagefind-meta` syntax splits on.
const pubIso = pubDate.toISOString().slice(0, 10)

// standard.site document AT-URI for the <head> verification link tag (null for
// drafts, styleguides, or posts before the configured cutoff).
const standardSiteDocumentUri =
  getDocumentUri('articles', Astro.params.slug!, { draft, styleguide, redirectURL, pubDate }) ??
  undefined
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      type="article"
      pageType="article"
      image={ogImage}
      pubDate={pubDate}
      updatedDate={updatedDate}
      tags={tags}
      standardSiteDocumentUri={standardSiteDocumentUri}
      markdownUrl={markdownUrl}
    />
    {platform && redirectURL && <meta http-equiv="refresh" content={'0;url=' + redirectURL} />}
  </head>

  <body>
    <MainNavigation />
    <CommandPalette />
    {
      platform && redirectURL && (
        <div class="spinner-overlay">
          <Spinner size="5rem" />
        </div>
      )
    }
    <main id="main" tabindex="-1">
      <LLMDiscoveryNote />
      <article
        class="h-entry"
        itemscope
        itemtype="https://schema.org/Article"
        data-pagefind-body
        data-pagefind-meta="type:article"
      >
        {
          /* Date as a clean Pagefind meta + recency sort key. A dedicated empty
            element keeps it off the body text and avoids comma-joining metas
            (Pagefind 1.5 doesn't split `data-pagefind-meta="a:x, b:y"`). */
        }
        <span data-pagefind-meta={`date:${pubIso}`} data-pagefind-sort={`date:${pubIso}`}></span>
        {toc && <TableOfContents headings={headings} />}
        <LongFormProseTypography>
          {
            cover && coverAlt && (
              <div class="hero-image">
                <Image
                  src={cover}
                  alt={coverAlt}
                  layout="constrained"
                  width={1200}
                  height={240}
                  quality={85}
                  format="webp"
                />
              </div>
            )
          }
          <div class="post-header">
            <div class="metadata" data-pagefind-ignore>
              <FormattedDate date={pubDate} itemprop="datePublished" />
              {
                updatedDate && (
                  <span class="last-updated-on">
                    (updated <FormattedDate date={updatedDate} itemprop="dateModified" />)
                  </span>
                )
              }
              {readingTime && <span class="reading-time">· {readingTime}</span>}
              {draft && <span class="draft-notice">🚧 Draft</span>}
            </div>

            <h1 class="title p-name" itemprop="headline" data-pagefind-meta="title">{title}</h1>
          </div>
          <SeriesCallout series={series} currentId={Astro.params.slug!} />
          <slot />
          <div class="footer-actions" data-pagefind-ignore>
            <MarkdownContentActions markdownUrl={markdownUrl} />
            <BackToTopLink />
          </div>
        </LongFormProseTypography>
      </article>

      <Footer />
      <Lightbox />
      {hasFootnotes && <InlineFootnotes />}
      <style>
        /* Article needs position context for TOC */
        article {
          position: relative;
        }

        /* Article grid layout - 3 columns for full-bleed support */
        :global(.longform-prose) {
          --gutter: var(--space-m);
          display: grid;
          grid-template-columns:
            minmax(var(--gutter), 1fr)
            min(var(--measure-standard), calc(100% - var(--gutter) * 2))
            minmax(var(--gutter), 1fr);
        }

        /* All other elements span the middle column */
        :global(.longform-prose) > :global(*) {
          grid-column: 2 / 3;
        }

        /* Full-bleed elements span all columns */
        :global(.longform-prose) > :global(.full-bleed),
        .hero-image {
          grid-column: 1 / -1;
        }

        .spinner-overlay {
          min-height: 100vh;
          display: grid;
          place-content: center;
          background: var(--color-background);
        }

        .metadata {
          font-size: var(--font-size-sm);
          color: var(--color-accent);
          font-family: var(--font-code);
          margin-top: var(--space-s);
        }

        @media (max-width: 700px) {
          .metadata {
            padding-top: var(--space-l);
          }
        }

        .hero-image {
          aspect-ratio: 5 / 1;
          overflow: hidden;
        }

        .hero-image img {
          width: 100%;
          height: 100%;
          object-fit: cover;
          filter: light-dark(none, grayscale(70%));
        }

        .draft-notice {
          border: var(--border-width-base) solid var(--color-accent);
          color: var(--color-accent);
          font-family: var(--font-ui);
          padding: var(--space-2xs) var(--space-s);
          border-radius: var(--radius-sm);
          float: right;
        }

        .footer-actions {
          margin-top: var(--space-l);
          display: flex;
          justify-content: space-between;
          align-items: center;
        }
      </style>
    </main>
  </body>
</html>
