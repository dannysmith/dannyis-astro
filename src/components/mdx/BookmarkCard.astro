---
import { fetchLinkMetadata } from '@utils/fetchLinkMetadata'

export interface Props {
  url: string
  className?: string
}

const { url, className = '' } = Astro.props

// Fetched at build time, from cache where possible. Never throws — `status`
// says how much of the card we can fill in.
const data = await fetchLinkMetadata(url)

// With no title of its own, the card leans on the URL, so it shows more of it.
const location = data.title ? data.domain : (data.displayUrl ?? data.domain)

// Common types worth naming; anything else just isn't a web page we can preview.
const FILE_TYPES: Record<string, string> = {
  'application/pdf': 'PDF',
  'application/epub+zip': 'EPUB',
  'application/zip': 'ZIP',
  'text/plain': 'Text file',
}
const fileType = data.contentType
  ? (FILE_TYPES[data.contentType.split(';')[0].trim().toLowerCase()] ?? 'File')
  : null

const flags = [
  // Only 404/410 gets this: sites block and time out for temporary reasons.
  data.status === 'dead' ? 'Link may be dead' : null,
  data.archived ? 'Archived copy' : null,
  fileType,
].filter((flag): flag is string => Boolean(flag))
---

<div class={`bookmark-card cq ${className}`}>
  <a href={url} class="bookmark-link" target="_blank" rel="noopener noreferrer">
    <div class="bookmark-content">
      <span class="bookmark-title">{data.displayTitle}</span>
      {data.description && <p class="bookmark-description">{data.description}</p>}
      <span class="bookmark-meta">
        {location && <span class="bookmark-domain">{location}</span>}
        {flags.map(flag => <span class="bookmark-flag">{flag}</span>)}
      </span>
    </div>
    {data.image && <img src={data.image} alt="" loading="lazy" />}
  </a>
</div>

<style>
  .bookmark-link {
    display: block;
    overflow: hidden;
    text-decoration: none;
    color: inherit;

    background-color: var(--color-background-secondary);
    border: var(--border-width-hairline) solid var(--color-border);
    border-radius: var(--radius-sm);
    transition: border-color var(--duration-normal) var(--ease-in-out);

    &:hover {
      border-color: var(--color-accent);
    }

    img {
      width: 100%;
      object-fit: cover;
    }
  }

  .bookmark-content {
    padding: var(--space-s);
  }

  /* Domain and any flags share one wrapping row. */
  .bookmark-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2xs) var(--space-xs);
    margin-block-start: var(--space-2xs);
  }

  .bookmark-domain {
    font-family: var(--font-code);
    font-size: var(--font-size-xs);
    word-break: break-all;
  }

  .bookmark-flag {
    font-size: var(--font-size-xs);
    color: var(--color-text-secondary);
    border: var(--border-width-hairline) solid var(--color-border);
    border-radius: var(--radius-xs);
    padding-inline: var(--space-2xs);
  }

  .bookmark-title {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-semibold);
    line-height: var(--leading-snug);
    color: var(--color-accent);
    margin-block-end: var(--space-2xs);
    word-break: break-word;
  }

  .bookmark-description {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: var(--font-size-sm);
    line-height: var(--leading-normal);
    margin: 0;
  }

  /* Horizontal layout when container is wide enough */
  @container (min-width: 400px) {
    .bookmark-link {
      display: flex;
      align-items: stretch;
      min-height: var(--space-2xl);

      img {
        width: max(30cqi, calc(var(--space-2xl) * 2));
        aspect-ratio: 16 / 9;
        flex-shrink: 0;
        order: 2;
      }
    }

    .bookmark-content {
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
  }
</style>
