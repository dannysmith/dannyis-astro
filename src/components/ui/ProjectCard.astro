---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Pill from '@components/ui/Pill.astro';

// Stage → badge label + colour. Type is derived from the schema, so adding a
// stage in content.config.ts forces this map to be updated.
type ProjectStage = CollectionEntry<'projects'>['data']['stage'];

const STAGE_META: Record<ProjectStage, { label: string; color: string }> = {
  'active-development': { label: 'In active development', color: 'var(--color-accent)' },
  'actively-maintained': { label: 'Actively maintained', color: 'var(--color-green)' },
  finished: { label: 'Finished', color: 'var(--color-blue)' },
  paused: { label: 'Paused', color: 'var(--color-orange)' },
  archived: { label: 'Archived', color: 'var(--color-charcoal)' },
};

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, byline, stage, audience, icon, website, github } = project.data;

// Only surface audience as a hint when it's not the plain "public" case.
const audienceHint =
  audience === 'public-with-dragons'
    ? 'Here be dragons'
    : audience === 'personal-only'
      ? 'Just for me'
      : null;
---

<article class="project-card ui-style">
  <div class="icon">
    {
      icon ? (
        <Image src={icon} alt={`${title} icon`} width={64} height={64} />
      ) : (
        <span class="icon-fallback" aria-hidden="true">
          {title.charAt(0)}
        </span>
      )
    }
  </div>

  <div class="body">
    <div class="meta">
      <Pill text={STAGE_META[stage].label} color={STAGE_META[stage].color} />
      {audienceHint && <Pill text={audienceHint} />}
    </div>

    <h3 class="title">{title}</h3>
    <p class="byline">{byline}</p>

    {
      (website || github) && (
        <p class="links">
          {website && (
            <a href={website} target="_blank" rel="noopener">
              Website
            </a>
          )}
          {github && (
            <a href={github} target="_blank" rel="noopener">
              GitHub
            </a>
          )}
        </p>
      )
    }
  </div>
</article>

<style>
  .project-card {
    display: flex;
    gap: var(--space-s);
    padding: var(--space-s);
    background-color: var(--color-background-secondary);
    border: var(--border-width-hairline) solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .icon {
    flex-shrink: 0;
  }

  .icon img,
  .icon-fallback {
    width: 64px;
    height: 64px;
    border-radius: var(--radius-xs);
    object-fit: cover;
  }

  .icon-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-background);
    color: var(--color-text-secondary);
    font-family: var(--font-display);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
    text-transform: uppercase;
  }

  .body {
    min-width: 0;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-bottom: var(--space-2xs);
  }

  .title {
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-bold);
    line-height: var(--leading-snug);
  }

  .byline {
    margin-top: var(--space-3xs);
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
    line-height: var(--leading-normal);
  }

  .links {
    display: flex;
    gap: var(--space-s);
    margin-top: var(--space-xs);
    font-size: var(--font-size-sm);
  }
</style>
