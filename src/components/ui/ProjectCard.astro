---
import type { CollectionEntry } from 'astro:content'
import { render } from 'astro:content'
import { Image } from 'astro:assets'
import { Icon } from 'astro-icon/components'
import Pill from '@components/ui/Pill.astro'
import ProjectIcon from '@components/ui/ProjectIcon.astro'
import CompactCardTile from './CompactCardTile.astro'
import { generateSummary } from '@utils/content-summary'

// Types derived from the schema, so adding an enum value in content.config.ts
// forces these maps to be updated.
type ProjectStage = CollectionEntry<'projects'>['data']['stage']
type ProjectAudience = CollectionEntry<'projects'>['data']['audience']

// Pill metadata mirrors Pill's props (text + hover title), so it can be spread
// straight onto <Pill>. No colour => the pill's default outline style.
interface PillMeta {
  text: string
  title: string
  color?: string
  icon?: string
}

// Stage pill — always shown.
const STAGE_META: Record<ProjectStage, PillMeta> = {
  'active-development': {
    text: 'In active development',
    title: "I'm actively working on this right now.",
    color: 'var(--color-blue)',
    icon: 'heroicons:code-bracket-20-solid',
  },
  'actively-maintained': {
    text: 'Actively maintained',
    title:
      'Finished software that I actively keep healthy — dependency upgrades, bug fixes and small improvements.',
  },
  finished: {
    text: 'Finished',
    title:
      "Finished software I consider done. It works, but I don't necessarily keep it up to date.",
    icon: 'heroicons:check-circle-20-solid',
  },
  paused: {
    text: 'Paused',
    title: "Was in development, but I've set it aside for now.",
    icon: 'heroicons:pause-circle-20-solid',
  },
  archived: {
    text: 'Archived',
    title: "No longer working on this and don't intend to again. Probably archived on GitHub.",
    icon: 'heroicons:archive-box-20-solid',
  },
}

// Stage badge tint for the medium card (its cover badge needs a solid colour,
// unlike the outline pill the full card uses for most stages).
const STAGE_BADGE_COLOR: Record<ProjectStage, string> = {
  'active-development': 'var(--color-blue)',
  'actively-maintained': 'var(--color-green)',
  finished: 'var(--color-green)',
  paused: 'var(--color-yellow)',
  archived: 'var(--color-purple)',
}

// Audience pill — only shown when it's not plainly public.
const AUDIENCE_META: Partial<Record<ProjectAudience, PillMeta>> = {
  'public-with-dragons': {
    text: 'Here be dragons',
    title:
      'Publicly available and should work, but rough around the edges — alpha quality, or not much effort made to work for anyone but me.',
    color: 'var(--color-yellow)',
    icon: 'heroicons:exclamation-triangle-20-solid',
  },
  'personal-only': {
    text: 'Not for public consumption',
    title: 'I made this just for me — it is not intended for anyone else to use.',
    color: 'var(--color-yellow)',
    icon: 'heroicons:lock-closed-20-solid',
  },
}

interface Props {
  item: CollectionEntry<'projects'>
  /** Compact tile: icon + title + byline, the whole card links out. */
  compact?: boolean
  /** Full card: renders the project's markdown body inline (the /making view). */
  full?: boolean
}

const { item, compact = false, full = false } = Astro.props
const { title, byline, stage, audience, icon, image, website, github } = item.data

// Both the compact tile and the medium card link out to the project (website →
// GitHub → its /making anchor); only the full card renders the markdown body.
const compactHref = website ?? github ?? `/making#${item.id}`
const compactIsExternal = Boolean(website ?? github)
const Content = full ? (await render(item)).Content : null

// Medium card summary: first meaningful paragraph of the body, truncated.
const summary = full || compact ? '' : generateSummary(item, 220)

// Status pill first, audience pill (when not plainly public) after.
const audienceMeta = AUDIENCE_META[audience]
const pills: PillMeta[] = audienceMeta ? [STAGE_META[stage], audienceMeta] : [STAGE_META[stage]]

// External links, rendered as buttons — GitHub before website.
type ProjectLink = { href: string; variant: 'primary' | 'secondary'; label: string; icon?: string }
const links: ProjectLink[] = []
if (github)
  links.push({ href: github, variant: 'secondary', label: 'GitHub Repo', icon: 'social/github' })
if (website) links.push({ href: website, variant: 'primary', label: `${title} Website` })
---

{
  compact ? (
    <CompactCardTile href={compactHref} title={title} byline={byline} external={compactIsExternal}>
      <ProjectIcon icon={icon} title={title} />
    </CompactCardTile>
  ) : full ? (
    <article class="project-card ui-style" id={item.id}>
      <div class="identity">
        <div class="icon">
          <ProjectIcon icon={icon} title={title} />
        </div>

        <div class="header">
          <h2 class="title">{title}</h2>
          <p class="byline">{byline}</p>
        </div>

        <div class="meta">
          {pills.map(pill => (
            <Pill {...pill} />
          ))}
        </div>
      </div>

      {image && <Image class="project-image" src={image} alt="" width={1000} />}

      <div class="content flow">
        {Content && <Content />}
        {links.length > 0 && (
          <div class="links">
            {links.map(link => (
              <a
                class="project-button"
                data-variant={link.variant}
                href={link.href}
                target="_blank"
                rel="noopener"
              >
                {link.icon && <Icon name={link.icon} />}
                {link.label}
              </a>
            ))}
          </div>
        )}
      </div>
    </article>
  ) : (
    <article class="project-card-medium ui-style cq">
      <a
        class="card-link"
        href={compactHref}
        target={compactIsExternal ? '_blank' : undefined}
        rel={compactIsExternal ? 'noopener' : undefined}
      >
        <div class="card-cover">
          {image && <Image src={image} alt="" width={600} />}
          <span class="cover-badge type-badge">Project</span>
          <span
            class="cover-badge status-badge"
            style={`--_badge-color: ${STAGE_BADGE_COLOR[stage]}`}
          >
            {STAGE_META[stage].text}
          </span>
        </div>

        <span class="card-icon">
          <ProjectIcon icon={icon} title={title} />
        </span>

        <div class="card-content">
          <h3 class="card-title">{title}</h3>
          {summary && <p class="card-summary">{summary}</p>}
        </div>
      </a>

      {(github || website) && (
        <footer class="card-footer">
          {github && (
            <a class="footer-link" href={github} target="_blank" rel="noopener">
              <Icon name="social/github" />
              Code
            </a>
          )}
          {website && (
            <a class="footer-link" href={website} target="_blank" rel="noopener">
              Website
              <span class="external-arrow" aria-hidden="true">
                ↗
              </span>
            </a>
          )}
        </footer>
      )}
    </article>
  )
}

<style>
  /* Narrow (default): a single column — identity, then image, then content.
     Source order already matches, so no reordering needed here. The container
     itself is set by the consumer (e.g. .cq on the making page), not here. */
  .project-card {
    display: grid;
    gap: var(--space-m);
    grid-template-areas:
      'identity'
      'image'
      'content';

    padding: var(--space-l);
    border-radius: var(--radius-lg);
    background-color: var(--color-background-secondary);
  }

  /* Narrow: icon on the left; header and meta stacked in the column beside it. */
  .identity {
    grid-area: identity;
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas:
      'icon header'
      'meta meta';
    column-gap: var(--space-s);
    row-gap: var(--space-2xs);
    align-items: start;
  }

  .content {
    grid-area: content;
    line-height: var(--leading-normal);
  }

  .meta {
    grid-area: meta;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }

  .header {
    grid-area: header;
    font-family: var(--font-display);
    text-transform: uppercase;
    font-feature-settings: 'case' on;

    .title {
      font-size: var(--font-size-lg);
      font-weight: var(--font-weight-extrabold);
      margin-block-start: 0;
      text-wrap: balance;
    }

    .byline {
      font-size: var(--font-size-base);
      font-weight: var(--font-weight-light);
      color: var(--color-text-secondary);
      margin-block-start: 0;
      text-wrap: pretty;
    }
  }

  .icon {
    grid-area: icon;
    --_icon-size: 4rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-2xs);
    margin-block-start: var(--space-l);
  }

  .project-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.5em 1em;
    min-height: 44px;

    font-family: var(--font-ui);
    font-weight: var(--font-weight-medium);
    line-height: var(--leading-tight);
    text-decoration: none;

    border-radius: var(--radius-full);
    transition:
      background-color var(--duration-fast) var(--ease-in-out),
      border-color var(--duration-fast) var(--ease-in-out),
      color var(--duration-fast) var(--ease-in-out);

    &:active {
      scale: 0.98;
    }

    /* Primary (website): solid accent, always dark text for contrast. */
    &[data-variant='primary'] {
      background-color: var(--color-accent);
      color: var(--color-ink);

      &:hover {
        background-color: oklch(from var(--color-accent) calc(l - 0.1) c h);
      }
    }

    /* Secondary (GitHub): outline that picks up the accent on hover. */
    &[data-variant='secondary'] {
      background-color: transparent;
      color: var(--color-text);
      border: var(--border-width-hairline) solid var(--color-border);

      &:hover {
        border-color: var(--color-accent);
        color: var(--color-accent);
      }
    }

    & svg {
      inline-size: 1.15em;
      block-size: 1.15em;
    }

    /* Trailing arrow — decorative, so a pseudo-element keeps it out of the DOM. */
    &::after {
      content: '→';
      transition: translate var(--duration-fast) var(--ease-in-out);
    }

    &:hover::after {
      translate: 0.2em 0;
    }
  }

  .project-image {
    grid-area: image;
    align-self: start;
    inline-size: 100%;
    border-radius: var(--radius-md);
  }

  /* Wide: image out to the right; identity back to a single row with the status
     on the right. Placed last so these overrides win over the narrow base rules. */
  @container (min-width: 55rem) {
    .project-card {
      grid-template-columns: 1fr minmax(0, 20rem);
      grid-template-areas:
        'identity image'
        'content  image';
    }

    .identity {
      grid-template-columns: auto 1fr auto;
      grid-template-areas: 'icon header meta';
    }

    .meta {
      flex-direction: row-reverse;
    }
  }

  @container (max-width: 30rem) {
    .byline {
      text-transform: none;
      font-size: var(--font-size-sm);
    }
  }

  /* =====================================================================
     Medium variant (default) — a ToolCard-style tile: the site's bordered
     card with a left accent bar that grows on hover/focus, a cover strip (the
     project image) carrying a "Project" badge and a tinted status badge, a
     Notion-style overlapping icon, the title, the first body paragraph, and a
     footer of external links. The body links out (as the compact tile does);
     the footer links sit outside that anchor so they stay clickable.
     ===================================================================== */
  .project-card-medium {
    --_border-color: var(--color-accent);
    --_icon-size: 2.75rem;

    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background-color: var(--color-background-secondary);
    border: var(--border-width-hairline) solid var(--color-border);
    border-radius: var(--radius-sm);
    transition: border-color var(--duration-fast) var(--ease-in-out);

    &::before {
      content: '';
      position: absolute;
      inset-block: 0;
      inset-inline-start: 0;
      inline-size: var(--border-width-thick);
      background: var(--_border-color);
      transition: inline-size var(--duration-fast) var(--ease-in-out);
      z-index: 1;
    }

    &:hover,
    &:has(:focus-visible) {
      border-color: var(--_border-color);

      &::before {
        inline-size: var(--border-width-heavy);
      }
    }
  }

  /* The link grows so the footer always sits at the bottom of the card. */
  .card-link {
    flex-grow: 1;

    &:focus-visible {
      outline: var(--border-width-base) solid var(--color-accent);
      outline-offset: 2px;
    }
  }

  /* Cover strip; badges sit in its corners. The height cap stops the 3:1 ratio
     producing an enormous cover in very wide containers. A base fill gives
     image-less projects a visible header strip. */
  .card-cover {
    position: relative;
    inline-size: 100%;
    aspect-ratio: 3 / 1;
    max-block-size: 10rem;
    background-color: var(--color-white);
  }

  /* Pin the responsive image to the (capped) cover box — see ArticleCard. */
  .card-cover :global(img) {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .cover-badge {
    position: absolute;
    padding: 0.4em 0.7em 0.3em;
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    line-height: 1;
    text-transform: uppercase;
    font-feature-settings: 'case' on;
    letter-spacing: var(--tracking-wide);
    color: var(--color-white);
    background-color: oklch(0% 0 0 / 55%);
    backdrop-filter: blur(4px);
    border-radius: var(--radius-xs);
  }

  .type-badge {
    inset-block-start: var(--space-2xs);
    inset-inline-start: var(--space-2xs);
  }

  /* Same dark translucent treatment, tinted per status. */
  .status-badge {
    inset-block-end: var(--space-2xs);
    inset-inline-end: var(--space-2xs);
    background-color: oklch(from var(--_badge-color) 35% c h / 80%);
  }

  /* Icon half-overlaps the bottom edge of the cover, Notion-style. */
  .card-icon {
    position: relative;
    display: block;
    inline-size: fit-content;
    margin-block-start: calc(var(--_icon-size) / -2);
    margin-inline-start: var(--space-s);
    line-height: 1;
  }

  /* Title and summary spacing lean on the .ui-style defaults. */
  .card-content {
    padding-block: var(--space-2xs) var(--space-s);
    padding-inline: var(--space-s);
  }

  .card-title {
    font-family: var(--font-display);
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-extrabold);
    text-transform: uppercase;
    font-feature-settings: 'case' on;
    letter-spacing: var(--tracking-tight);
  }

  .card-summary {
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
    line-height: var(--leading-normal);

    /* Already ~first paragraph; clamp defensively. */
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 6;
    line-clamp: 6;
    overflow: hidden;
  }

  .card-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-2xs) var(--space-s);
    padding: var(--space-2xs) var(--space-s);
    border-block-start: var(--border-width-hairline) solid var(--color-border);
    font-size: var(--font-size-xs);
  }

  .footer-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;

    & svg {
      inline-size: 1.1em;
      block-size: 1.1em;
    }
  }

  /* Narrow: shrink the icon, badges and summary. */
  @container (width < 350px) {
    .project-card-medium {
      --_icon-size: 2rem;
    }

    .cover-badge {
      font-size: calc(var(--font-size-xs) * 0.8);
    }

    .card-summary {
      font-size: var(--font-size-xs);
      -webkit-line-clamp: 5;
      line-clamp: 5;
    }
  }
</style>
