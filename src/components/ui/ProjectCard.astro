---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Pill from '@components/ui/Pill.astro';

// Types derived from the schema, so adding an enum value in content.config.ts
// forces these maps to be updated.
type ProjectStage = CollectionEntry<'projects'>['data']['stage'];
type ProjectAudience = CollectionEntry<'projects'>['data']['audience'];

// Pill metadata: label + hover explanation, optional fill colour and leading icon.
// No colour => the pill's default outline style.
interface PillMeta {
  label: string;
  description: string;
  color?: string;
  icon?: string;
}

// Stage pill — always shown.
const STAGE_META: Record<ProjectStage, PillMeta> = {
  'active-development': {
    label: 'In active development',
    description: "I'm actively working on this right now.",
    color: 'var(--color-blue)',
    icon: 'heroicons:code-bracket-20-solid',
  },
  'actively-maintained': {
    label: 'Actively maintained',
    description:
      'Finished software that I actively keep healthy — dependency upgrades, bug fixes and small improvements.',
  },
  finished: {
    label: 'Finished',
    description:
      "Finished software I consider done. It works, but I don't necessarily keep it up to date.",
    icon: 'heroicons:check-circle-20-solid',
  },
  paused: {
    label: 'Paused',
    description: "Was in development, but I've set it aside for now.",
    icon: 'heroicons:pause-circle-20-solid',
  },
  archived: {
    label: 'Archived',
    description:
      "No longer working on this and don't intend to again. Probably archived on GitHub.",
    icon: 'heroicons:archive-box-20-solid',
  },
};

// Audience pill — only shown when it's not plainly public.
const AUDIENCE_META: Partial<Record<ProjectAudience, PillMeta>> = {
  'public-with-dragons': {
    label: 'Here be dragons',
    description:
      'Publicly available and should work, but rough around the edges — alpha quality, or not much effort made to work for anyone but me.',
    color: 'var(--color-yellow)',
    icon: 'heroicons:exclamation-triangle-20-solid',
  },
  'personal-only': {
    label: 'Not for public consumption',
    description: 'I made this just for me — it is not intended for anyone else to use.',
    color: 'var(--color-yellow)',
    icon: 'heroicons:lock-closed-20-solid',
  },
};

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, byline, stage, audience, icon, image, website, github } = project.data;

// The markdown body of the project, rendered inline (no per-project pages).
const { Content } = await render(project);

const stageMeta = STAGE_META[stage];
const audienceMeta = AUDIENCE_META[audience];
---

<article class="project-card ui-style">
  <div class="identity">
    <div class="icon">
      {
        icon ? (
          <Image src={icon} alt={`${title} icon`} width={128} height={128} />
        ) : (
          <span class="icon-fallback" aria-hidden="true">
            {title.charAt(0)}
          </span>
        )
      }
    </div>

    <div class="header">
      <h3 class="title">{title}</h3>
      <h4 class="byline">{byline}</h4>
    </div>

    <div class="meta">
      {
        audienceMeta && (
          <Pill
            text={audienceMeta.label}
            title={audienceMeta.description}
            color={audienceMeta.color}
            icon={audienceMeta.icon}
          />
        )
      }
      <Pill
        text={stageMeta.label}
        title={stageMeta.description}
        color={stageMeta.color}
        icon={stageMeta.icon}
      />
    </div>
  </div>

  {image && <Image class="project-image" src={image} alt="" width={1000} />}

  <div class="content flow">
    <Content />
    {
      (website || github) && (
        <div class="links">
          {github && (
            <a
              class="project-button"
              data-variant="secondary"
              href={github}
              target="_blank"
              rel="noopener"
            >
              <Icon name="social/github" />
              <span class="label">GitHub Repo</span>
              <span class="arrow" aria-hidden="true">
                →
              </span>
            </a>
          )}
          {website && (
            <a
              class="project-button"
              data-variant="primary"
              href={website}
              target="_blank"
              rel="noopener"
            >
              <span class="label">{title} Website</span>
              <span class="arrow" aria-hidden="true">
                →
              </span>
            </a>
          )}
        </div>
      )
    }
  </div>
</article>

<style>
  /* Narrow (default): a single column — identity, then image, then content.
     Source order already matches, so no reordering needed here. The container
     itself is set by the consumer (e.g. .cq on the making page), not here. */
  .project-card {
    display: grid;
    gap: var(--space-m);
    grid-template-areas:
      'identity'
      'image'
      'content';

    padding: 2rem;
    border-radius: var(--radius-lg);
    background-color: var(--color-background-secondary);
    margin: 2rem;
  }

  .identity {
    grid-area: identity;
  }
  .project-image {
    grid-area: image;
  }
  .content {
    grid-area: content;
  }

  /* Wide: image moves out to the right, spanning the identity + content rows. */
  @container (min-width: 55rem) {
    .project-card {
      grid-template-columns: 1fr minmax(0, 20rem);
      grid-template-areas:
        'identity image'
        'content  image';
    }
  }

  /* Icon on the left, header beside it, pills pushed out to the top-right. */
  .identity {
    display: flex;
    align-items: flex-start;
    gap: var(--space-s);
  }

  .meta {
    margin-inline-start: auto;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-2xs);
  }

  .header {
    font-family: var(--font-display);
    text-wrap: wrap;
    text-transform: uppercase;
    font-feature-settings: 'case' on;

    h3 {
      font-size: var(--font-size-lg);
      font-weight: var(--font-weight-extrabold);
      margin-block-start: 0;
    }

    h4 {
      font-size: var(--font-size-base);
      font-weight: var(--font-weight-light);
      color: var(--color-text-secondary);
      margin-block-start: 0;
    }
  }

  .icon {
    --_icon-size: 4rem;
    flex-shrink: 0;
    inline-size: var(--_icon-size);
  }

  .icon :is(img, .icon-fallback) {
    inline-size: 100%;
    aspect-ratio: 1;
    border-radius: var(--radius-md);
  }

  .icon img {
    object-fit: cover;
  }

  .icon-fallback {
    display: grid;
    place-items: center;
    background-color: var(--color-text);
    color: var(--color-background);
    font-family: var(--font-display);
    font-size: calc(var(--_icon-size) * 0.55);
    font-weight: var(--font-weight-extrabold);
    line-height: 1;
    text-transform: uppercase;
    font-feature-settings: 'case' on;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-2xs);
    margin-block-start: var(--space-l);
  }

  .project-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.5em 1em;
    min-height: 44px;

    font-family: var(--font-ui);
    font-weight: var(--font-weight-medium);
    line-height: var(--leading-tight);
    text-decoration: none;

    border-radius: var(--radius-full);
    transition:
      background-color var(--duration-fast) var(--ease-in-out),
      border-color var(--duration-fast) var(--ease-in-out),
      color var(--duration-fast) var(--ease-in-out);

    &:active {
      scale: 0.98;
    }

    /* Primary (website): solid accent, always dark text for contrast. */
    &[data-variant='primary'] {
      background-color: var(--color-accent);
      color: var(--color-ink);

      &:visited {
        color: var(--color-ink);
      }

      &:hover {
        background-color: oklch(from var(--color-accent) calc(l - 0.1) c h);
      }
    }

    /* Secondary (GitHub): outline that picks up the accent on hover. */
    &[data-variant='secondary'] {
      background-color: transparent;
      color: var(--color-text);
      border: var(--border-width-hairline) solid var(--color-border);

      &:visited {
        color: var(--color-text);
      }

      &:hover {
        border-color: var(--color-accent);
        color: var(--color-accent);
      }
    }

    & svg {
      inline-size: 1.15em;
      block-size: 1.15em;
    }

    & .arrow {
      transition: translate var(--duration-fast) var(--ease-in-out);
    }

    &:hover .arrow {
      translate: 0.2em 0;
    }
  }

  .project-image {
    align-self: start;
    inline-size: 100%;
    block-size: auto;
    border-radius: var(--radius-md);
  }
</style>
