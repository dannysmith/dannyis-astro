---
/**
 * Internal building block for the card components' compact variants — a single
 * clickable "go to the thing" tile: optional icon, title and byline, with the
 * site's accent-bar hover idiom. Each tile is its own size container and drops
 * the byline when rendered narrower than 20rem.
 *
 * Not consumer-facing: use the `compact` prop on ToolCard, ProjectCard, etc.
 * The default slot takes the icon (an emoji, <img> or component); cards style
 * their own slotted icon content, the tile only provides the fixed box.
 */
interface Props {
  href: string
  title: string
  byline?: string
  /** Per-type accent, e.g. `var(--color-green)` for tools */
  accentColor?: string
  /** Open in a new tab (external links) */
  external?: boolean
}

const { href, title, byline, accentColor = 'var(--color-accent)', external = false } = Astro.props

// Render the slot up front so a conditional that came out empty (e.g. a tool
// with no icon) doesn't leave an empty icon box in the layout.
const icon = Astro.slots.has('default') ? (await Astro.slots.render('default')).trim() : ''
---

<a
  class="compact-card-tile ui-style cq"
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener' : undefined}
  style={`--_accent-color: ${accentColor}`}
>
  {icon && <span class="tile-icon" set:html={icon} />}
  <span class="tile-text">
    <span class="tile-title">{title}</span>
    {byline && <span class="tile-byline">{byline}</span>}
  </span>
</a>

<style>
  .compact-card-tile {
    --_icon-size: 3rem;

    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-s);
    padding: var(--space-s);
    overflow: hidden;
    background-color: var(--color-background-secondary);
    border: var(--border-width-hairline) solid var(--color-border);
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: border-color var(--duration-fast) var(--ease-in-out);

    &::before {
      content: '';
      position: absolute;
      inset-block: 0;
      inset-inline-start: 0;
      inline-size: var(--border-width-thick);
      background: var(--_accent-color);
      transition: inline-size var(--duration-fast) var(--ease-in-out);
    }

    &:hover,
    &:focus-visible {
      border-color: var(--_accent-color);

      &::before {
        inline-size: var(--border-width-heavy);
      }
    }
  }

  .tile-icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    /* Fixed box keeps titles aligned in a stack; emoji glyphs render larger
       than same-size images, so they get a smaller font-size within it. */
    inline-size: var(--_icon-size);
    font-size: calc(var(--_icon-size) * 0.75);
    line-height: 1;
  }

  .tile-text {
    display: flex;
    flex-direction: column;
    min-inline-size: 0;
  }

  .tile-title {
    font-family: var(--font-display);
    font-weight: var(--font-weight-extrabold);
    text-transform: uppercase;
    font-feature-settings: 'case' on;
    line-height: var(--leading-tight);
    color: var(--color-text);
  }

  .tile-byline {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  /* Narrow tile: drop the byline */
  @container (width < 20rem) {
    .tile-byline {
      display: none;
    }
  }
</style>
