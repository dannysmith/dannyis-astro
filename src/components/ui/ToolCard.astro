---
import type { CollectionEntry } from 'astro:content'
import { FormattedDate } from '@components/ui/index'
import CompactCardTile from './CompactCardTile.astro'

/**
 * Card for a page from the Remote Working Toolbox (`toolboxPages` collection).
 * Links out to the tool on betterat.work.
 *
 * Variants:
 * - **Full** (default) — cover image with "Tool" and category badges, a
 *   Notion-style overlapping icon, title, truncated summary, and a footer
 *   with dates and a "View in Notion" link.
 * - **Compact** — the shared CompactCardTile: icon, title and category byline.
 *
 * Each card is its own size container, so both variants adapt to the width
 * they're rendered at.
 *
 * Usage:
 *   <ToolCard item={entry} />
 *   <ToolCard item={entry} compact />
 */
interface Props {
  /** A `toolboxPages` collection entry */
  item: CollectionEntry<'toolboxPages'>
  /** Render the compact tile instead of the full card */
  compact?: boolean
}

const { item, compact = false } = Astro.props
const { data } = item

// Tint the category badge from the standard palette, cycling by a hash of the
// category name so colours are stable however many categories exist.
const CATEGORY_COLORS = ['coral', 'pink', 'orange', 'purple', 'yellow', 'green', 'blue']
const hash = [...(data.category ?? '')].reduce((acc, ch) => acc + ch.charCodeAt(0), 0)
const categoryColor = `var(--color-${CATEGORY_COLORS[hash % CATEGORY_COLORS.length]})`

// Only show "Updated" when it differs from the created date at day granularity
const updatedSameDay = data.created.toDateString() === data.lastEdited.toDateString()
---

{
  compact ? (
    <CompactCardTile
      href={data.url}
      title={data.title}
      byline={data.category ? `Tool filed under ${data.category}` : 'Tool'}
      accentColor="var(--color-green)"
    >
      {data.emoji ??
        (data.iconUrl && <img class="compact-icon-img" src={data.iconUrl} alt="" loading="lazy" />)}
    </CompactCardTile>
  ) : (
    <article
      class="tool-card card-shell ui-style cq"
      data-notion-id={data.notionId}
      data-category={data.category}
      style={`view-transition-name: tool-${item.id}`}
    >
      <a href={data.url} class="card-link">
        <div class="card-cover">
          {data.coverImage && (
            <img
              class="img-cover"
              src={data.coverImage}
              alt=""
              width="600"
              height="200"
              loading="lazy"
            />
          )}
          <span class="cover-badge type-badge">Tool</span>
          {data.category && (
            <span class="cover-badge category-badge" style={`--_badge-color: ${categoryColor}`}>
              {data.category}
            </span>
          )}
        </div>

        {(data.emoji || data.iconUrl) && (
          <span class="card-icon">
            {data.emoji ?? <img src={data.iconUrl} alt="" loading="lazy" />}
          </span>
        )}

        <div class="card-content">
          <h3 class="card-title">{data.title}</h3>
          {data.summary && <p class="card-summary">{data.summary}</p>}
        </div>
      </a>

      <footer class="card-footer">
        <span>
          Added <FormattedDate date={data.created} />
          {!updatedSameDay && (
            <>
              · Updated <FormattedDate date={data.lastEdited} />
            </>
          )}
        </span>
        <a class="notion-link" href={data.notionUrl}>
          View in Notion
        </a>
      </footer>
    </article>
  )
}

<style>
  .tool-card {
    --_border-color: var(--color-green);
    --_icon-size: 2.5rem;

    display: flex;
    flex-direction: column;
  }

  /* Image icons fill the icon box; emoji size comes from font-size. The
     compact-icon-img rule targets the icon slotted into CompactCardTile,
     which sets the inherited --_icon-size. */
  .card-icon img,
  .compact-icon-img {
    display: block;
    inline-size: var(--_icon-size);
    block-size: var(--_icon-size);
    object-fit: contain;
    border-radius: var(--radius-xs);
  }

  .card-link {
    flex-grow: 1;

    &:focus-visible {
      outline: var(--border-width-base) solid var(--color-accent);
      outline-offset: 2px;
    }
  }

  /* Height cap stops the 3:1 ratio producing an enormous cover in very wide containers. */
  .card-cover {
    position: relative;
    /* Explicit width so aspect-ratio derives the height (with auto width it would
       derive width from the capped height and stop filling the card). */
    inline-size: 100%;
    aspect-ratio: 3 / 1;
    max-block-size: 10rem;
  }

  .cover-badge {
    position: absolute;
    padding: 0.4em 0.7em 0.3em;
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    line-height: 1;
    text-transform: uppercase;
    font-feature-settings: 'case' on;
    letter-spacing: var(--tracking-wide);
    color: var(--color-white);
    background-color: oklch(0% 0 0 / 55%);
    backdrop-filter: blur(4px);
    border-radius: var(--radius-xs);
  }

  .type-badge {
    inset-block-start: var(--space-2xs);
    inset-inline-start: var(--space-2xs);
  }

  .category-badge {
    inset-block-end: var(--space-2xs);
    inset-inline-end: var(--space-2xs);
    background-color: oklch(from var(--_badge-color) 35% c h / 80%);
  }

  /* Icon half-overlaps the bottom edge of the cover, Notion-style */
  .card-icon {
    position: relative;
    display: block;
    inline-size: fit-content;
    margin-block-start: calc(var(--_icon-size) / -2);
    margin-inline-start: var(--space-s);
    font-size: var(--_icon-size);
    line-height: 1;
  }

  .card-content {
    padding-block: var(--space-2xs) var(--space-s);
    padding-inline: var(--space-s);
  }

  .card-title {
    font-family: var(--font-display);
    font-size: var(--font-size-base);
    letter-spacing: var(--tracking-tight);
  }

  .card-summary {
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
    line-height: var(--leading-normal);

    /* Defensive summary clamp */
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 12;
    line-clamp: 12;
    overflow: hidden;
  }

  .card-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-2xs);
    padding: var(--space-2xs) var(--space-s);
    border-block-start: var(--border-width-hairline) solid var(--color-border);
    font-size: var(--font-size-xs);
    color: var(--color-text-secondary);
  }

  .notion-link {
    text-decoration-line: underline;
    text-underline-offset: 0.2em;
  }

  @container (width < 350px) {
    .card-icon {
      --_icon-size: 1.8rem;
    }

    .cover-badge {
      font-size: calc(var(--font-size-xs) * 0.8);
    }

    .card-summary {
      font-size: var(--font-size-xs);
      -webkit-line-clamp: 9;
      line-clamp: 9;
    }

    .notion-link {
      display: none;
    }
  }
</style>
