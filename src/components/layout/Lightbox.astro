<!-- Lightbox HTML -->
<div class="lightbox" id="lightbox">
  <span class="lightbox-close" id="close">&times;</span>
  <canvas id="lightboxCanvas"></canvas>
</div>

<style is:global>
  /* Prevent background scroll when lightbox is open */
  html:has(.lightbox.is-open) {
    overflow: hidden;
  }
</style>

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    background: oklch(0% 0 0 / 0.9);
    display: none;
    justify-content: center;
    align-items: center;
    z-index: 1000;

    &.is-open {
      display: flex;
    }
  }

  .lightbox canvas {
    max-width: 90%;
    max-height: 90%;
  }

  .lightbox-close {
    position: absolute;
    top: var(--space-m);
    right: var(--space-m);
    font-size: var(--font-size-xl);
    line-height: var(--leading-none);
    color: var(--color-white);
    cursor: pointer;
  }
</style>

<script>
  // Lightbox Script
  document.addEventListener('DOMContentLoaded', function () {
    const lightbox = document.getElementById('lightbox') as HTMLDivElement
    const lightboxCanvas = document.getElementById('lightboxCanvas') as HTMLCanvasElement
    const ctx = lightboxCanvas.getContext('2d')
    const closeBtn = document.getElementById('close') as HTMLSpanElement

    // Any image whose click already means something else (following a link,
    // triggering a control) must not also open the lightbox, or the two fire
    // together. `[data-no-lightbox]` is an explicit opt-out, honoured on the
    // <img> or any ancestor — see docs/developer/component-patterns.md.
    const SKIP = 'a[href], button, summary, label, [role="button"], [data-no-lightbox]'

    function openLightbox(clickedImg: HTMLImageElement) {
      lightbox.classList.add('is-open')

      const image = new Image()
      image.src = clickedImg.src
      image.onload = function () {
        lightboxCanvas.width = image.width
        lightboxCanvas.height = image.height
        if (ctx) {
          ctx.clearRect(0, 0, lightboxCanvas.width, lightboxCanvas.height)
          ctx.drawImage(image, 0, 0, lightboxCanvas.width, lightboxCanvas.height)
        }
      }
    }

    // Delegated so it also covers images added after load, and evaluates the
    // skip rules at click time.
    document.addEventListener('click', function (event) {
      const img = (event.target as HTMLElement).closest?.('img[alt]') as HTMLImageElement | null
      if (!img || img.closest(SKIP)) return
      openLightbox(img)
    })

    closeBtn.addEventListener('click', function () {
      lightbox.classList.remove('is-open')
    })

    lightbox.addEventListener('click', function (event) {
      if (event.target !== lightboxCanvas && event.target !== closeBtn) {
        lightbox.classList.remove('is-open')
      }
    })
  })

  // Never restore an open lightbox from the bfcache: after a full-page
  // navigation, Back would otherwise show the page with the lightbox still up.
  window.addEventListener('pageshow', function () {
    document.getElementById('lightbox')?.classList.remove('is-open')
  })
</script>
