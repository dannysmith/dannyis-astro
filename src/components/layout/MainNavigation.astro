---
/**
 * The site's main menu (items in @config/navigation). One menu, two
 * presentations:
 *
 *   - Wider than a phone: a drawer from the left, opened from a button
 *     top-left.
 *   - Phones: a round button bottom-left, in thumb reach, opening a card that
 *     floats just above it.
 *
 * The menu is a native `popover`, so there's no script: the browser handles
 * open/close, Esc, click-outside and returning focus. Search opens the command
 * palette with an invoker command, which also closes the menu.
 */
import { Icon } from 'astro-icon/components'
import { NavList, ThemeToggle } from '@components/navigation/index'
import { PersonalLogo } from '@components/ui/index'
import { NAV } from '@config/navigation'
import SkipLink from './SkipLink.astro'
---

<SkipLink />
<button class="nav-open no-print" type="button" popovertarget="main-navigation" aria-label="Menu">
  <Icon name="heroicons:bars-3-20-solid" class="icon-open" aria-hidden="true" />
  <Icon name="heroicons:x-mark-20-solid" class="icon-close" aria-hidden="true" />
</button>
<nav
  id="main-navigation"
  popover
  class="main-navigation ui-style dark-surface no-print"
  aria-label="Main"
>
  <div class="nav-header">
    <PersonalLogo />
    <button
      class="nav-search-icon"
      type="button"
      command="show-modal"
      commandfor="command-palette"
      aria-label="Search"
      title="Search"
    >
      <Icon name="heroicons:magnifying-glass-20-solid" aria-hidden="true" />
    </button>
    <button
      class="nav-close"
      type="button"
      autofocus
      popovertarget="main-navigation"
      popovertargetaction="hide"
      aria-label="Close menu"
    >
      <Icon name="heroicons:x-mark-20-solid" aria-hidden="true" />
    </button>
  </div>
  <div class="nav-links all-caps">
    {
      NAV.map(section => (
        <section class="nav-section">
          {section.heading && <h2 class="nav-heading">{section.heading}</h2>}
          <NavList items={section.items} />
        </section>
      ))
    }
  </div>
  <div class="nav-tools">
    <button class="nav-search" type="button" command="show-modal" commandfor="command-palette">
      <Icon name="heroicons:magnifying-glass-20-solid" aria-hidden="true" />
      Search
    </button>
    <ThemeToggle />
  </div>
</nav>

<style>
  /* ----------------------------------------
     Wider than a phone: a drawer
     ---------------------------------------- */

  .nav-open {
    position: fixed;
    top: var(--space-s);
    left: var(--space-s);
    padding: var(--space-2xs);
    z-index: 1000;
    background: oklch(from var(--color-background-secondary) l c h / 0.8);
    color: var(--color-accent);
  }

  .icon-close {
    display: none;
  }

  .main-navigation {
    /* Undo the UA's centred popover */
    inset: 0 auto 0 0;
    margin: 0;
    min-inline-size: 18rem; /* Wide enough for logo + close button */
    block-size: 100dvh;
    max-block-size: none;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: var(--space-s);
    border: 0;
    border-inline-end: var(--border-width-accent) solid var(--color-accent);
    /* Set here, not with display below: display: flex is held through the
       exit transition, and a row layout would widen the menu as it closes */
    flex-direction: column;
    gap: var(--space-m);

    translate: -100% 0;
    transition:
      translate var(--duration-normal) var(--ease-in-out),
      scale var(--duration-normal) var(--ease-in-out),
      opacity var(--duration-normal) var(--ease-in-out),
      display var(--duration-normal) allow-discrete,
      overlay var(--duration-normal) allow-discrete;

    /* Only set display while open, or it overrides the UA's display: none */
    &:popover-open {
      display: flex;
      translate: 0;

      @starting-style {
        translate: -100% 0;
      }
    }

    &::backdrop {
      background: transparent;
    }
  }

  .nav-header {
    display: flex;
    align-items: center;
    gap: var(--space-3xs);

    & button {
      padding: var(--space-3xs);
      background: transparent;
    }
  }

  .nav-search-icon {
    margin-inline-start: auto;
  }

  /* The lists come from NavList, so reach them with :global() */
  .nav-links {
    padding-inline-start: calc(var(--space-s) * 2);

    & :global(li) {
      margin-block-start: var(--space-2xs);
    }

    /* Sub-items: indented, smaller, hung off a rule */
    & :global(li > ul) {
      margin-block-start: var(--space-3xs);
      padding-inline-start: var(--space-s);
      border-inline-start: var(--border-width-hairline) solid
        color-mix(in oklch, currentColor 30%, transparent);
      font-size: var(--font-size-sm);
    }

    & :global(a[aria-current='page']) {
      color: var(--color-accent);
    }

    & :global(a[aria-current='true']) {
      color: color-mix(in oklch, var(--color-accent) 70%, currentColor);
    }
  }

  .nav-section + .nav-section {
    margin-block-start: var(--space-m);
  }

  .nav-heading {
    margin: 0 0 var(--space-3xs);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-normal);
    color: color-mix(in oklch, currentColor 50%, transparent);
  }

  .nav-tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-s);
  }

  /* Phones only; wider viewports use the icon in the header */
  .nav-search {
    display: none;
    align-items: center;
    gap: var(--space-3xs);
    padding: var(--space-2xs) var(--space-s);
    border-radius: var(--radius-full);
    background: color-mix(in oklch, currentColor 12%, transparent);
    font-size: var(--font-size-sm);

    &:hover:not(:disabled) {
      background: color-mix(in oklch, currentColor 20%, transparent);
    }
  }

  /* ----------------------------------------
     Phones: a floating button bottom-left
     opening a card just above it
     ---------------------------------------- */

  @media (width < 40rem) {
    /* Global so the footer can leave room for the button too */
    :global(:root) {
      --menu-button-size: 3.5rem;
    }

    .nav-open {
      inset: auto auto var(--space-s) var(--space-s);
      display: grid;
      place-items: center;
      inline-size: var(--menu-button-size);
      aspect-ratio: 1;
      padding: 0;
      border-radius: var(--radius-full);
      box-shadow: 0 0.25rem 0.75rem oklch(0% 0 0 / 0.3);

      & svg {
        inline-size: 1.5rem;
        block-size: 1.5rem;
      }
    }

    /* Swap to a cross while the menu is open */
    .nav-open:has(+ :popover-open) {
      & .icon-open {
        display: none;
      }
      & .icon-close {
        display: block;
      }
    }

    .main-navigation {
      inset: auto var(--space-s) calc(var(--menu-button-size) + var(--space-s) + var(--space-xs));
      min-inline-size: 0;
      inline-size: auto;
      block-size: auto;
      max-block-size: calc(100dvh - var(--menu-button-size) - var(--space-2xl));
      padding: var(--space-m);
      border: 0;
      border-radius: var(--radius-lg);
      box-shadow: 0 1rem 2.5rem oklch(0% 0 0 / 0.35);
      transform-origin: bottom left;

      translate: 0;
      scale: 0.96;
      opacity: 0;

      &:popover-open {
        scale: 1;
        opacity: 1;

        @starting-style {
          /* Override the drawer's slide-in */
          translate: 0;
          scale: 0.96;
          opacity: 0;
        }
      }
    }

    .nav-header {
      display: none;
    }

    .nav-links {
      padding-inline-start: 0;
      font-size: var(--font-size-md);

      & :global(a) {
        display: block;
        padding-block: var(--space-3xs);
      }
    }

    .nav-search {
      display: inline-flex;
    }

    .nav-tools {
      justify-content: space-between;
      padding-block-start: var(--space-s);
      border-block-start: var(--border-width-hairline) solid
        color-mix(in oklch, currentColor 20%, transparent);
    }
  }
</style>
