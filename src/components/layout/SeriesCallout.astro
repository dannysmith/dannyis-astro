---
import { getCollection, getEntry, type CollectionEntry } from 'astro:content';
import { Callout, Spacer } from '@components/mdx/index';
import { getPublishedSeriesArticles } from '@utils/content';

interface Props {
  /** The `series` reference from the current article's frontmatter (if any). */
  series: CollectionEntry<'articles'>['data']['series'];
  /** The current article's id, so it can be marked in the list. */
  currentId: string;
}

const { series, currentId } = Astro.props;

const seriesEntry = series ? await getEntry(series) : undefined;
const articles = seriesEntry
  ? getPublishedSeriesArticles(seriesEntry.data.id, await getCollection('articles'))
  : [];

// A "part of a series" box listing only the current article is pointless, so
// only render once there are at least two entries. In production drafts are
// filtered out; in development they show prefixed with "[draft]".
const show = seriesEntry && articles.length >= 2;
---

{
  show && (
    <>
      <Callout
        title={`This article is part of a series`}
        icon="heroicons:rectangle-stack-20-solid"
        className="series-callout"
      >
        {seriesEntry.data.intro && <p class="series-intro">{seriesEntry.data.intro}</p>}
        <ol class="series-list">
          {articles.map(entry => {
            const isCurrent = entry.id === currentId;
            const label = `${entry.data.draft ? '[draft] ' : ''}${entry.data.title}`;
            return (
              <li aria-current={isCurrent ? 'true' : undefined}>
                {isCurrent ? (
                  <strong>{label}</strong>
                ) : (
                  <a href={`/writing/${entry.id}/`}>{label}</a>
                )}
              </li>
            );
          })}
        </ol>
      </Callout>
      <Spacer size="m" />
    </>
  )
}

<style>
  .series-list {
    li {
      margin: 0;
    }

    li[aria-current='true'] {
      color: var(--color-text);
    }
  }
</style>
